{
  "name": "@marea/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "mutation": "stryker run stryker.config.mjs",
    "test": "vitest run",
    "test:bun": "bun --bun vitest run && bun run build",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marea/i18n": "workspace:*",
    "@marea/protocol": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "@marea/plugin-api": "workspace:*",
    "@marea/plugin-runtime": "workspace:*"
  },
  "devDependencies": {
    "@marea/test-config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.2.2"
  }
}
