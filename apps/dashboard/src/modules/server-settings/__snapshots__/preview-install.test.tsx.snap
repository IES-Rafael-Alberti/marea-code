exports[`hides unpublished builds and renders selectable commands in all supported languages > en 1`] = `"<aside class="preview-install"><h3>Install Marea for students</h3><p>Copy the command for the student&#x27;s system. The address must be reachable from their computer.</p><label>Server address for students<select><option value="" disabled="">Choose the classroom network address</option><option value="https://school.test" selected="">https://school.test</option></select></label><p>Marea 0.1.0-preview.1 · <a href="https://github.com/school/marea/releases" target="_blank" rel="noreferrer">Preview versions</a></p><label>macOS / Linux<textarea readOnly="" rows="3">curl -fsSL &#x27;https://github.com/school/marea/releases/download/v0.1.0-preview.1/install.sh&#x27; | sh -s -- student --server &#x27;https://school.test&#x27;</textarea></label><label>Windows PowerShell<textarea readOnly="" rows="3">&amp; ([scriptblock]::Create((Invoke-RestMethod &#x27;https://github.com/school/marea/releases/download/v0.1.0-preview.1/install.ps1&#x27;))) -Component student -Server &#x27;https://school.test&#x27;</textarea></label></aside>"`;

exports[`hides unpublished builds and renders selectable commands in all supported languages > es 1`] = `"<aside class="preview-install"><h3>Instalar Marea para el alumnado</h3><p>Copia el comando del sistema del alumno. La dirección debe ser accesible desde su equipo.</p><label>Dirección del servidor para el alumnado<select><option value="" disabled="">Elige la dirección de la red del aula</option><option value="https://school.test" selected="">https://school.test</option></select></label><p>Marea 0.1.0-preview.1 · <a href="https://github.com/school/marea/releases" target="_blank" rel="noreferrer">Versiones de prueba</a></p><label>macOS / Linux<textarea readOnly="" rows="3">curl -fsSL &#x27;https://github.com/school/marea/releases/download/v0.1.0-preview.1/install.sh&#x27; | sh -s -- student --server &#x27;https://school.test&#x27;</textarea></label><label>Windows PowerShell<textarea readOnly="" rows="3">&amp; ([scriptblock]::Create((Invoke-RestMethod &#x27;https://github.com/school/marea/releases/download/v0.1.0-preview.1/install.ps1&#x27;))) -Component student -Server &#x27;https://school.test&#x27;</textarea></label></aside>"`;

exports[`hides unpublished builds and renders selectable commands in all supported languages > eu 1`] = `"<aside class="preview-install"><h3>Instalatu Marea ikasleentzat</h3><p>Kopiatu ikaslearen sistemarako komandoa. Helbideak ikaslearen ordenagailutik eskuragarri egon behar du.</p><label>Zerbitzariaren helbidea ikasleentzat<select><option value="" disabled="">Aukeratu ikasgelako sarearen helbidea</option><option value="https://school.test" selected="">https://school.test</option></select></label><p>Marea 0.1.0-preview.1 · <a href="https://github.com/school/marea/releases" target="_blank" rel="noreferrer">Probako bertsioak</a></p><label>macOS / Linux<textarea readOnly="" rows="3">curl -fsSL &#x27;https://github.com/school/marea/releases/download/v0.1.0-preview.1/install.sh&#x27; | sh -s -- student --server &#x27;https://school.test&#x27;</textarea></label><label>Windows PowerShell<textarea readOnly="" rows="3">&amp; ([scriptblock]::Create((Invoke-RestMethod &#x27;https://github.com/school/marea/releases/download/v0.1.0-preview.1/install.ps1&#x27;))) -Component student -Server &#x27;https://school.test&#x27;</textarea></label></aside>"`;
