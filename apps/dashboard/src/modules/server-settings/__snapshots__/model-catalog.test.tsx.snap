exports[`preserves the complete model and pricing form with legacy routes=false 1`] = `"<h3>2. Model for sessions</h3><p class="server-help">The main model serves tutoring and, unless you choose another, evaluation.</p><label class="server-field">Provider<select><option value="" disabled="">Provider</option><option value="p" selected="">P</option></select></label><label class="server-field">Main model<input required="" list="models-tutoring" value="org/model"/><datalist id="models-tutoring"><option value="org/model">Model</option></datalist></label><div class="server-common" data-active="false"><p>New sessions in every class will use this model.</p></div><h3>3. Limits and prices</h3><p class="server-help">Usage is unlimited by default. Choosing a catalog model fills its editable prices. If you type a different model, review prices manually. Prices are estimates and exclude discounts and caching.</p><details class="workspace-advanced"><summary>Tutoring · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Unlimited usage</label><label>USD per million input tokens<input type="number" min="0" step="0.001" required="" value="1.25"/></label><label>USD per million output tokens<input type="number" min="0" step="0.001" required="" value="5"/></label></div></details><details class="workspace-advanced"><summary>Evaluation · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox"/>Unlimited usage</label><label>Maximum requests<input type="number" min="0" required="" step="1" value="1000"/></label><label>Total tokens<input type="number" min="0" required="" step="1" value="2000000"/></label><label>Input tokens per request<input type="number" min="0" required="" step="1" value="131072"/></label><label>Output tokens per request<input type="number" min="0" required="" step="1" value="32768"/></label><label>Concurrent requests<input type="number" min="0" required="" step="1" value="4"/></label><label>Maximum duration (ms)<input type="number" min="0" required="" step="1" value="300000"/></label><label>Tool calls<input type="number" min="0" required="" step="1" value="1000"/></label><label>Cost ceiling (units)<input type="number" min="0" required="" step="1" value="10000000000"/></label><label>Units per input token<input type="number" min="0" step="1" required="" value="2"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="3"/></label><label>Cost unit<input required="" value="credits"/></label></div></details><details class="workspace-advanced"><summary>Models and limits by task</summary><fieldset><legend>Evaluation</legend><label class="server-field">Main model<input required="" list="models-evaluation" value="org/model"/><datalist id="models-evaluation"><option value="org/model">Model</option></datalist></label><label class="server-field">Provider<select><option value="p" selected="">P</option></select></label></fieldset><fieldset><legend>Map · per class and day</legend><label><input type="checkbox" checked=""/>Configure this feature</label><label class="server-field">Main model<input required="" list="models-map" value="map"/><datalist id="models-map"><option value="org/model">Model</option></datalist></label><label class="server-field">Provider<select><option value="p" selected="">P</option></select></label><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Unlimited usage</label><label>Units per input token<input type="number" min="0" step="1" required="" value="0"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="0"/></label><label>Cost unit<input required="" value="units"/></label></div></fieldset><fieldset><legend>Reports · per attempt</legend><label><input type="checkbox"/>Configure this feature</label></fieldset></details>"`;

exports[`preserves the complete model and pricing form with legacy routes=true 1`] = `"<h3>2. Model for sessions</h3><p class="server-help">The main model serves tutoring and, unless you choose another, evaluation.</p><label class="server-field">Provider<select><option value="" disabled="">Provider</option><option value="p" selected="">P</option></select></label><label class="server-field">Main model<input required="" list="models-tutoring" value="org/model"/><datalist id="models-tutoring"><option value="org/model">Model</option></datalist></label><div class="server-common" data-active="false"><label><input type="checkbox"/>Use this connection and model for new sessions in every class</label><p>Each class keeps its current model until you enable this option.</p><p>Enabling this replaces class routes for new sessions. Open sessions remain unchanged.</p><details><summary>Current model of each class (1)</summary><ul><li><strong>class:old</strong> · P · <code>old</code></li></ul></details></div><h3>3. Limits and prices</h3><p class="server-help">Usage is unlimited by default. Choosing a catalog model fills its editable prices. If you type a different model, review prices manually. Prices are estimates and exclude discounts and caching.</p><details class="workspace-advanced"><summary>Tutoring · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Unlimited usage</label><label>USD per million input tokens<input type="number" min="0" step="0.001" required="" value="1.25"/></label><label>USD per million output tokens<input type="number" min="0" step="0.001" required="" value="5"/></label></div></details><details class="workspace-advanced"><summary>Evaluation · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox"/>Unlimited usage</label><label>Maximum requests<input type="number" min="0" required="" step="1" value="1000"/></label><label>Total tokens<input type="number" min="0" required="" step="1" value="2000000"/></label><label>Input tokens per request<input type="number" min="0" required="" step="1" value="131072"/></label><label>Output tokens per request<input type="number" min="0" required="" step="1" value="32768"/></label><label>Concurrent requests<input type="number" min="0" required="" step="1" value="4"/></label><label>Maximum duration (ms)<input type="number" min="0" required="" step="1" value="300000"/></label><label>Tool calls<input type="number" min="0" required="" step="1" value="1000"/></label><label>Cost ceiling (units)<input type="number" min="0" required="" step="1" value="10000000000"/></label><label>Units per input token<input type="number" min="0" step="1" required="" value="2"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="3"/></label><label>Cost unit<input required="" value="credits"/></label></div></details><details class="workspace-advanced"><summary>Models and limits by task</summary><fieldset><legend>Evaluation</legend><label class="server-field">Main model<input required="" list="models-evaluation" value="org/model"/><datalist id="models-evaluation"><option value="org/model">Model</option></datalist></label><label class="server-field">Provider<select><option value="p" selected="">P</option></select></label></fieldset><fieldset><legend>Map · per class and day</legend><label><input type="checkbox" checked=""/>Configure this feature</label><label class="server-field">Main model<input required="" list="models-map" value="map"/><datalist id="models-map"><option value="org/model">Model</option></datalist></label><label class="server-field">Provider<select><option value="p" selected="">P</option></select></label><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Unlimited usage</label><label>Units per input token<input type="number" min="0" step="1" required="" value="0"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="0"/></label><label>Cost unit<input required="" value="units"/></label></div></fieldset><fieldset><legend>Reports · per attempt</legend><label><input type="checkbox"/>Configure this feature</label></fieldset></details>"`;
