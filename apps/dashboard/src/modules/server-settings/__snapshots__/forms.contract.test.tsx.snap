exports[`preserves provider fields and their disclosure during setup: false > false 1`] = `"<h3>Provider connections</h3><p class="server-help">Credentials belong to the server and are never shown again after saving. Entering a key checks the connection and loads available models.</p><details class="workspace-advanced" open=""><summary>Name p1</summary><label><input type="checkbox" checked=""/>Enable connection</label><label class="server-field">One<span class="secret-control"><input autoComplete="off" required="" type="password" aria-label="One" value=""/><button type="button" aria-label="Show or hide: One" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span></label><label class="server-field">Endpoint<input type="url" autoComplete="off" value=""/></label></details>"`;

exports[`preserves provider fields and their disclosure during setup: true > true 1`] = `"<section class="workspace-advanced"><h2>Name p1</h2><label class="server-field">One<span class="secret-control"><input autoComplete="off" required="" type="password" aria-label="One" value=""/><button type="button" aria-label="Show or hide: One" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span></label><details class="connection-options"><summary>Connection options</summary><label class="server-field">Endpoint<input type="url" autoComplete="off" value=""/></label></details></section>"`;
