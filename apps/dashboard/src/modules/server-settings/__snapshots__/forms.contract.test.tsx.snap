exports[`groups models, limits and optional model routes into separate sections > all 1`] = `"<h3>Model for sessions</h3><p class="server-help">The main model serves tutoring and, unless you choose another, evaluation.</p><label class="server-field">Provider<select><option value="" disabled="">Provider</option><option value="p1" selected="">Name p1</option><option value="p2" disabled="">p2</option></select></label><div data-settings-section="models"><label class="server-field">Main model<input required="" list="models-tutoring" value="main"/><datalist id="models-tutoring"></datalist></label><div class="server-common" data-active="false"><p>New sessions in every class will use this model.</p></div></div><div data-settings-section="limits"><h3>Limits and prices</h3><p class="server-help">Usage is unlimited by default. Choosing a catalog model fills its editable prices. If you type a different model, review prices manually. Prices are estimates and exclude discounts and caching.</p><details class="workspace-advanced"><summary>Tutoring · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox"/>Unlimited usage</label><label>Maximum requests<input type="number" min="0" required="" step="1" value="1000"/></label><label>Total tokens<input type="number" min="0" required="" step="1" value="2000000"/></label><label>Input tokens per request<input type="number" min="0" required="" step="1" value="80"/></label><label>Output tokens per request<input type="number" min="0" required="" step="1" value="32768"/></label><label>Concurrent requests<input type="number" min="0" required="" step="1" value="4"/></label><label>Maximum duration (ms)<input type="number" min="0" required="" step="1" value="300000"/></label><label>Tool calls<input type="number" min="0" required="" step="1" value="1000"/></label><label>Cost ceiling (units)<input type="number" min="0" required="" step="1" value="10000000000"/></label><div class="price-source"><p>Custom or unchecked prices</p></div><label>Units per input token<input type="number" min="0" step="1" required="" value="0"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="0"/></label><label>Cost unit<input required="" value="units"/></label></div></details><details class="workspace-advanced"><summary>Evaluation · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox"/>Unlimited usage</label><label>Maximum requests<input type="number" min="0" required="" step="1" value="1000"/></label><label>Total tokens<input type="number" min="0" required="" step="1" value="2000000"/></label><label>Input tokens per request<input type="number" min="0" required="" step="1" value="50"/></label><label>Output tokens per request<input type="number" min="0" required="" step="1" value="32768"/></label><label>Concurrent requests<input type="number" min="0" required="" step="1" value="4"/></label><label>Maximum duration (ms)<input type="number" min="0" required="" step="1" value="300000"/></label><label>Tool calls<input type="number" min="0" required="" step="1" value="1000"/></label><label>Cost ceiling (units)<input type="number" min="0" required="" step="1" value="10000000000"/></label><div class="price-source"><p>Custom or unchecked prices</p></div><label>Units per input token<input type="number" min="0" step="1" required="" value="0"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="0"/></label><label>Cost unit<input required="" value="units"/></label></div></details></div><details data-settings-section="features" class="workspace-advanced"><summary>Models and limits by task</summary><fieldset><legend>Evaluation</legend><label class="server-field">Main model<input required="" list="models-evaluation" value="main"/><datalist id="models-evaluation"></datalist></label><label class="server-field">Provider<select><option value="p1" selected="">Name p1</option><option value="p2" disabled="">p2</option></select></label></fieldset><fieldset><legend>Map · per class and day</legend><label><input type="checkbox"/>Configure this feature</label></fieldset><fieldset><legend>Reports · per attempt</legend><label><input type="checkbox"/>Configure this feature</label></fieldset></details>"`;

