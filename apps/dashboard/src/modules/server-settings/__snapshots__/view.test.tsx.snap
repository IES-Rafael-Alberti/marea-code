// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`keeps each server task in its visible section, with drafts mounted in hidden sections > features 1`] = `"<section class="dashboard-module server-settings" aria-busy="false"><h2>Server settings</h2><nav class="settings-subnavigation"><button type="button">Connection and model</button><button type="button">School accounts</button><button type="button">Network and installation</button><button type="button" aria-current="page">Feature models</button><button type="button">Costs and limits</button><button type="button">External traces</button></nav><form noValidate="" data-dirty="false"><fieldset><div data-settings-section="models" hidden=""><h3>Provider connections</h3><p class="server-help">Credentials belong to the server and are never shown again after saving. Entering a key checks the connection and loads available models.</p><details class="workspace-advanced" open=""><summary>P</summary><label><input type="checkbox" disabled="" checked=""/>Enable connection</label><p class="server-help">Used by a configured route: it cannot be disabled.</p></details><details class="workspace-advanced"><summary>p2</summary><p>This provider is unavailable for configuration. If it was removed, choose another connection and model. Its saved settings are preserved.</p></details></div><div data-settings-section="models" hidden=""><label class="server-field">Main model<input required="" list="models-tutoring" value="main"/><datalist id="models-tutoring"></datalist></label><div class="server-common" data-active="false"><p>New sessions in every class will use this model.</p></div></div><div data-settings-section="limits" hidden=""><h3>Limits and prices</h3><p class="server-help">Usage is unlimited by default. Choosing a catalog model fills its editable prices. If you type a different model, review prices manually. Prices are estimates and exclude discounts and caching.</p><details class="workspace-advanced"><summary>Tutoring · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Unlimited usage</label><div class="price-source"><p>Custom or unchecked prices</p></div><label>Units per input token<input type="number" min="0" step="1" required="" value="0"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="0"/></label><label>Cost unit<input required="" value="units"/></label></div></details><details class="workspace-advanced"><summary>Evaluation · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Unlimited usage</label><div class="price-source"><p>Custom or unchecked prices</p></div><label>Units per input token<input type="number" min="0" step="1" required="" value="0"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="0"/></label><label>Cost unit<input required="" value="units"/></label></div></details></div><details data-settings-section="features" class="workspace-advanced" open=""><summary>Models and limits by task</summary><fieldset><legend>Evaluation</legend><label class="server-field">Main model<input required="" list="models-evaluation" value="main"/><datalist id="models-evaluation"></datalist></label><p class="server-provider-name">P</p></fieldset><fieldset><legend>Map · per class and day</legend><label><input type="checkbox"/>Configure this feature</label></fieldset><fieldset><legend>Reports · per attempt</legend><label><input type="checkbox"/>Configure this feature</label></fieldset></details></fieldset><div class="server-actions"><button type="submit" disabled="">Save configuration</button><button type="button">Reload</button></div></form><div hidden=""><section class="identity-settings" aria-busy="false"><h3>School accounts</h3><p>Connect school accounts here. Choose who may join in each class&#x27;s address and group settings.</p></section></div><div hidden=""><section class="observability-settings" aria-busy="false"><h3>Observability</h3><p>Send new turns with content: conversation, model calls, tools, questions and approvals. Only the server sends data. Configuration secrets are masked.</p><p>External copies follow destination retention. Technical pseudonyms do not anonymize content. Disabling or changing destination discards pending deliveries; earlier history is not sent.</p><button type="button">Refresh status</button></section></div><div hidden=""></div></section>"`;

