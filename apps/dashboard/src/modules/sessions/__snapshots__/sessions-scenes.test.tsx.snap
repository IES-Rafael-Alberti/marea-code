exports[`preserves the complete es classroom copy and readable presentation > unselected session list 1`] = `"<section class="session-workspace show-list" aria-label="Sesiones"><aside class="session-list"><h2>Sesiones</h2><p class="session-live connection-current">Actualizado · 1 en la lista</p><label>Clase<select><option value="" selected="">Todas las clases</option><option value="class:one">Physics</option></select></label><div class="session-filters"><input aria-label="Buscar estudiante o proyecto" placeholder="Buscar estudiante o proyecto" maxLength="80" value=""/><select aria-label="Mostrar"><option value="all" selected="">Todas las sesiones</option><option value="open">Abiertas ahora</option><option value="closed">Finalizadas</option><option value="pending">Pendientes con evidencia</option><option value="empty">Pendientes sin evidencia</option><option value="approved">Aprobadas</option><option value="failed">Evaluación fallida</option><option value="running">Evaluando o en cola</option></select></div><ul><li><button><span class="session-row-head"><span class="session-state session-state-closed" aria-hidden="true"></span><strong>Ada</strong></span><span>Boundary tests</span><small><time dateTime="2026-09-08T08:00:00.000Z">08:00</time> · Programming · Finalizada</small><small class="session-review session-review-none">Sin evaluación</small></button></li></ul><div class="actions"><button>Más recientes</button><button>Sesiones anteriores</button></div></aside><div class="session-detail"><header class="session-detail-header"><button class="session-back">Volver a las sesiones</button><h2>Conversación</h2><p></p><p role="status" class="connection-current">Actualizado</p><p class="muted">La actividad registrada se actualiza en vivo, con recuperación periódica si falla la conexión. Una sesión abierta no significa que el estudiante esté conectado.</p></header><p class="empty-state">Selecciona una sesión para seguir la conversación.</p></div></section>"`;
