// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`loads scoped students and exports the complete selection including dates and pseudonyms > class export form and safety notes 1`] = `"<details class="session-export"><summary>Export sessions</summary><p>Download a ZIP containing conversations, events and usage summary. Pseudonyms do not hide names or personal data written inside the content.</p><form><fieldset><label>Student<select><option value="" selected="">All</option><option value="s1">One</option></select></label><label>From (UTC)<input type="date" value=""/></label><label>Until (UTC, exclusive)<input type="date" min="" value=""/></label><label>Identities<select><option value="names" selected="">Names</option><option value="pseudonyms">Pseudonyms</option></select></label><button type="submit">Download selection</button></fieldset></form></details>"`;
