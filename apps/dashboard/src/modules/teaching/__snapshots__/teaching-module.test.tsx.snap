// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`teaching module > renders accessible en copy and stable headings 1`] = `
"<section class="dashboard-module teaching-module" aria-labelledby="teaching-heading" aria-busy="false"><h2 id="teaching-heading">Class teaching configuration</h2><h3>Classes</h3><div class="teaching-classes"><button>Reload classes</button><label>Class<select><option value="" disabled="">Choose a class to read or create its teaching configuration.</option><option value="class:one" selected="">Physics</option></select></label></div><div class="teaching-configuration"><h3>Physics</h3><p class="teaching-version">Saved version revision:one</p><p class="teaching-note">Saves affect new sessions only; already-open snapshots keep their frozen configuration.</p><div class="teaching-actions"><button>Reload current configuration</button><button>Save configuration</button></div><fieldset class="teaching-editor"><legend>Agent mode</legend><label>Agent mode<select><option value="tutoring" selected="">Guided tutoring</option><option value="free">Free mode</option></select></label><p class="teaching-note">Edit the complete instructions for each mode; neither field can be empty. Restoring defaults only changes this draft; save to apply it to new sessions. Tool permissions and safety rules remain enforced separately.</p><label>Guided mode instructions<textarea rows="6" maxLength="262144">Start from the failed boundary test.
Ask for one hypothesis before revealing hints.</textarea></label><button type="button">Restore guided mode defaults</button><label>Free mode instructions<textarea rows="6" maxLength="262144">Support the project without taking over.
Keep tool use visible to the student.</textarea></label><button type="button">Restore free mode defaults</button><fieldset class="teaching-skills teaching-skills-didactic"><legend>Didactic skills</legend><p>Up to 64 didactic skills can be selected.</p><div class="teaching-skill"><label><input type="checkbox" checked="" value="marea/guided-inquiry:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"/>guided-inquiry</label><p class="teaching-skill-description">Description: A deliberately long teaching description used to check wrapping, overflow behaviour and realistic catalog copy in the teacher configuration view.</p><p class="teaching-skill-meta">Source: marea · Digest: <code>sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</code></p></div><div class="teaching-skill"><label><input type="checkbox" value="teacher/alice/exercise-lab:sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"/>exercise-lab</label><p class="teaching-skill-description">Description: A deliberately long teaching description used to check wrapping, overflow behaviour and realistic catalog copy in the teacher configuration view.</p><p class="teaching-skill-meta">Source: teacher · Digest: <code>sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb</code></p></div></fieldset><fieldset class="teaching-skills teaching-skills-evaluation"><legend>Evaluation methods</legend><p>Automatic evaluation stays off without a selected evaluation method.</p><div class="teaching-skill"><label><input type="checkbox" checked="" value="center/north/laboratory-rubric:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"/>laboratory-rubric</label><p class="teaching-skill-description">Description: A deliberately long teaching description used to check wrapping, overflow behaviour and realistic catalog copy in the teacher configuration view.</p><p class="teaching-skill-meta">Source: center · Digest: <code>sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</code></p></div></fieldset><label class="teaching-automatic"><input type="checkbox" checked=""/>Automatic evaluation</label></fieldset></div></section>"
`;

exports[`teaching module > renders accessible es copy and stable headings 1`] = `
"<section class="dashboard-module teaching-module" aria-labelledby="teaching-heading" aria-busy="false"><h2 id="teaching-heading">Configuración docente de la clase</h2><h3>Clases</h3><div class="teaching-classes"><button>Recargar clases</button><label>Clase<select><option value="" disabled="">Elige una clase para leer o crear su configuración docente.</option><option value="class:one" selected="">Physics</option></select></label></div><div class="teaching-configuration"><h3>Physics</h3><p class="teaching-version">Versión guardada revision:one</p><p class="teaching-note">Los guardados afectan solo a las sesiones nuevas; las sesiones ya abiertas conservan su configuración congelada.</p><div class="teaching-actions"><button>Recargar configuración actual</button><button>Guardar configuración</button></div><fieldset class="teaching-editor"><legend>Modo del agente</legend><label>Modo del agente<select><option value="tutoring" selected="">Tutoría guiada</option><option value="free">Modo libre</option></select></label><p class="teaching-note">Edita las instrucciones completas de cada modo; ninguno de los dos campos puede quedar vacío. Restaurar los valores predeterminados solo cambia este borrador; guarda para aplicarlo a sesiones nuevas. Los permisos de herramientas y las reglas de seguridad se mantienen por separado.</p><label>Instrucciones del modo guiado<textarea rows="6" maxLength="262144">Start from the failed boundary test.
Ask for one hypothesis before revealing hints.</textarea></label><button type="button">Restaurar instrucciones del modo guiado</button><label>Instrucciones del modo libre<textarea rows="6" maxLength="262144">Support the project without taking over.
Keep tool use visible to the student.</textarea></label><button type="button">Restaurar instrucciones del modo libre</button><fieldset class="teaching-skills teaching-skills-didactic"><legend>Skills didácticas</legend><p>Se pueden seleccionar hasta 64 skills didácticas.</p><div class="teaching-skill"><label><input type="checkbox" checked="" value="marea/guided-inquiry:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"/>guided-inquiry</label><p class="teaching-skill-description">Descripción: A deliberately long teaching description used to check wrapping, overflow behaviour and realistic catalog copy in the teacher configuration view.</p><p class="teaching-skill-meta">Fuente: marea · Digest: <code>sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</code></p></div><div class="teaching-skill"><label><input type="checkbox" value="teacher/alice/exercise-lab:sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"/>exercise-lab</label><p class="teaching-skill-description">Descripción: A deliberately long teaching description used to check wrapping, overflow behaviour and realistic catalog copy in the teacher configuration view.</p><p class="teaching-skill-meta">Fuente: teacher · Digest: <code>sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb</code></p></div></fieldset><fieldset class="teaching-skills teaching-skills-evaluation"><legend>Métodos de evaluación</legend><p>La evaluación automática permanece desactivada sin un método de evaluación seleccionado.</p><div class="teaching-skill"><label><input type="checkbox" checked="" value="center/north/laboratory-rubric:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"/>laboratory-rubric</label><p class="teaching-skill-description">Descripción: A deliberately long teaching description used to check wrapping, overflow behaviour and realistic catalog copy in the teacher configuration view.</p><p class="teaching-skill-meta">Fuente: center · Digest: <code>sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</code></p></div></fieldset><label class="teaching-automatic"><input type="checkbox" checked=""/>Evaluación automática</label></fieldset></div></section>"
`;
