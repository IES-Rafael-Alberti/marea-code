// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shows paused and unhealthy destinations, permits disabling removed plugins and retries failures > removed destination with queue status 1`] = `"<section class="observability-settings" aria-busy="false"><h3>Observability</h3><p>Send new turns with content: conversation, model calls, tools, questions and approvals. Only the server sends data. Configuration secrets are masked.</p><p>External copies follow destination retention. Technical pseudonyms do not anonymize content. Disabling or changing destination discards pending deliveries; earlier history is not sent.</p><form><fieldset><label>Destination<select><option value="">Choose a plugin</option><option value="removed" selected="">Plugin not installed</option></select></label><label><input type="checkbox" checked=""/>Enable delivery with content</label><button type="submit">Save observability</button><button type="button" disabled="">Test connection</button></fieldset></form><button type="button">Refresh status</button><p>Destination unavailable; delivery paused</p><p role="alert">The queue needs attention; student sessions continue working.</p><p>Pending: 3 · Failed: 2 · Sent: 4 · Dropped at queue limit: 1</p><p>Last delivery: 2026-10-08T00:00:00.000Z</p><button type="button">Retry failed deliveries</button></section>"`;

exports[`uses plugin fields and keeps saved secrets out of ordinary reads and unchanged writes > inactive destination form 1`] = `"<section class="observability-settings" aria-busy="false"><h3>Observability</h3><p>Send new turns with content: conversation, model calls, tools, questions and approvals. Only the server sends data. Configuration secrets are masked.</p><p>External copies follow destination retention. Technical pseudonyms do not anonymize content. Disabling or changing destination discards pending deliveries; earlier history is not sent.</p><form><fieldset><label>Destination<select><option value="" selected="">Choose a plugin</option><option value="test">Collector</option></select></label><label><input type="checkbox" disabled=""/>Enable delivery with content</label><button type="submit" disabled="">Save observability</button><button type="button" disabled="">Test connection</button></fieldset></form><button type="button">Refresh status</button><p>Delivery disabled</p><p>Pending: 0 · Failed: 0 · Sent: 0 · Dropped at queue limit: 0</p><p>Last delivery: None</p><button type="button" disabled="">Retry failed deliveries</button></section>"`;
