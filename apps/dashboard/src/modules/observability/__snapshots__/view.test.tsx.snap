// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`enables delivery saving only for a selected edited destination and clears feedback on edits > pending destination draft 1`] = `"<section class="observability-settings" aria-busy="false"><h3>Observability</h3><p>Send new turns with content: conversation, model calls, tools, questions and approvals. Only the server sends data. Configuration secrets are masked.</p><p>External copies follow destination retention. Technical pseudonyms do not anonymize content. Disabling or changing destination discards pending deliveries; earlier history is not sent.</p><form data-dirty="true"><fieldset><label>Destination<select><option value="">Choose a plugin</option><option value="test" selected="">Collector</option></select></label><label>URL<input autoComplete="off" required="" type="url" value="https://collector.test"/></label><label>Key<details class="saved-secret"><summary>Key saved · Change</summary><span class="secret-control"><input autoComplete="off" placeholder="Already configured; leave empty to keep" type="password" aria-label="Key" value=""/><button type="button" aria-label="Show or hide: Key" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span></details></label><label>Optional<input autoComplete="off" type="text" value=""/></label><label><input type="checkbox"/>Enable delivery with content</label><button type="submit">Save observability</button><button type="button">Test connection</button><button type="button">Discard changes</button><p role="status">Unsaved changes.</p></fieldset></form><button type="button">Refresh status</button><p>Delivery disabled</p><p>Pending: 0 · Failed: 0 · Sent: 0 · Dropped at queue limit: 0</p><p>Last delivery: None</p><button type="button" disabled="">Retry failed deliveries</button></section>"`;

exports[`shows paused and unhealthy destinations, permits disabling removed plugins and retries failures > removed destination with queue status 1`] = `"<section class="observability-settings" aria-busy="false"><h3>Observability</h3><p>Send new turns with content: conversation, model calls, tools, questions and approvals. Only the server sends data. Configuration secrets are masked.</p><p>External copies follow destination retention. Technical pseudonyms do not anonymize content. Disabling or changing destination discards pending deliveries; earlier history is not sent.</p><form data-dirty="false"><fieldset><label>Destination<select><option value="">Choose a plugin</option><option value="removed" selected="">Plugin not installed</option></select></label><label><input type="checkbox" checked=""/>Enable delivery with content</label><button type="submit" disabled="">Save observability</button><button type="button" disabled="">Test connection</button><button type="button" disabled="">Discard changes</button></fieldset></form><button type="button">Refresh status</button><p>Destination unavailable; delivery paused</p><p role="alert">The queue needs attention; student sessions continue working.</p><p>Pending: 3 · Failed: 2 · Sent: 4 · Dropped at queue limit: 1</p><p>Last delivery: 2026-10-08T00:00:00.000Z</p><button type="button">Retry failed deliveries</button></section>"`;

exports[`uses plugin fields and keeps saved secrets out of ordinary reads and unchanged writes > inactive destination form 1`] = `"<section class="observability-settings" aria-busy="false"><h3>Observability</h3><p>Send new turns with content: conversation, model calls, tools, questions and approvals. Only the server sends data. Configuration secrets are masked.</p><p>External copies follow destination retention. Technical pseudonyms do not anonymize content. Disabling or changing destination discards pending deliveries; earlier history is not sent.</p><form data-dirty="false"><fieldset><label>Destination<select><option value="" selected="">Choose a plugin</option><option value="test">Collector</option></select></label><label><input type="checkbox" disabled=""/>Enable delivery with content</label><button type="submit" disabled="">Save observability</button><button type="button" disabled="">Test connection</button><button type="button" disabled="">Discard changes</button></fieldset></form><button type="button">Refresh status</button><p>Delivery disabled</p><p>Pending: 0 · Failed: 0 · Sent: 0 · Dropped at queue limit: 0</p><p>Last delivery: None</p><button type="button" disabled="">Retry failed deliveries</button></section>"`;
