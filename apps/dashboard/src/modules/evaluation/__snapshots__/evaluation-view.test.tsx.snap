exports[`evaluation review surface > has complete en review copy and a stable accessible draft view 2`] = `"<section class="dashboard-module evaluation-module" aria-labelledby="evaluation-heading" aria-busy="false"><h2 id="evaluation-heading">Session evaluation</h2><div class="evaluation-layout"><nav aria-label="Closed sessions"><button>Load sessions</button><ul class="run-list"><li class="run-card"><strong>Ada</strong><p>Programming · Boundary tests</p><time>2026-09-08T08:00:00.000Z</time><button aria-current="true">Review</button></li></ul><button>Older sessions</button></nav><div><h3>run:one</h3><button>Reload review (discard local edits)</button><p role="status">Draft — requires teacher review</p><dl class="evaluation-metadata"><dt>Generation</dt><dd>1</dd><dt>Evaluation method</dt><dd>marea/evaluation</dd><dt>Frozen input</dt><dd><code>sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</code></dd></dl><fieldset class="evaluation-editor"><legend>Evaluation content</legend><p>Only the reviewed student feedback is sent. Notes, difficulties and criteria remain private.</p><label>Feedback sent to the student<textarea rows="6" maxLength="16384">Try an empty-input test next.</textarea></label><label>Private teacher note<textarea rows="4" maxLength="16384">Private teacher note.</textarea></label><label>Private difficulties (one per line)<textarea rows="4">No failure-case explanation.</textarea></label><details><summary>Private criterion assessments (1)</summary><fieldset><legend>marea/testing / C1</legend><label>Result<select><option value="passed">Met</option><option value="not-passed">Not met</option><option value="no-evidence" selected="">No evidence</option></select></label><label>Confidence<select><option value="low" selected="">Low</option><option value="medium">Medium</option><option value="high">High</option></select></label><label>Evidence<textarea rows="3" maxLength="2000"></textarea></label></fieldset></details></fieldset><div class="evaluation-actions"><button>Generate new draft</button><button>Approve and send feedback</button></div><h3>Canonical evidence</h3><article class="conversation-event event-run-activated"><header><strong>Session opened</strong><time dateTime="2026-09-08T08:00:00.000Z">08:00:00</time></header><div class="message-text"><p></p></div></article><button>Next evidence page</button></div></div></section>"`;

