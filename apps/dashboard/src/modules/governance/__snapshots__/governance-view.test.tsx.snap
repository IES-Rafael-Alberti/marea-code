exports[`governance administration view > renders a complete en administration surface 1`] = `
"<section class="dashboard-module governance-module" aria-labelledby="governance-heading" aria-busy="false"><h2 id="governance-heading">Center administration</h2><p class="governance-note">Actions are checked again by the server. Private operator settings are not managed here.</p><p role="alert">The result could not be confirmed. Reload to check before retrying.</p><nav class="governance-centers" aria-label="Centers"><h3>Centers</h3><button>Reload</button><ul class="governance-list"><li><span>Center a</span><button aria-current="true">Open</button></li><li><span>Center b</span><button>Open</button></li></ul></nav><div class="governance-layout"><section class="governance-classes" aria-label="Classes"><h3>Classes</h3><ul class="governance-list"><li><span>Physics</span><button aria-current="true">Open</button></li><li><span>Physics</span><button>Open</button></li></ul><form class="governance-create"><label>Class ID<input maxLength="128" name="classId"/></label><label>Display name<input maxLength="120" name="displayName"/></label><button type="submit">Create</button></form><div class="governance-pending-creates"><h4>Unconfirmed creations</h4><ul><li><span>class:c · Pending class</span><button>Show</button><button>Retry</button><button>Discard</button></li></ul></div><div class="governance-selected"><form class="governance-rename"><label>Display name<input maxLength="120" name="displayName" value="Physics"/></label><button type="submit">Save name</button></form><section class="governance-memberships" aria-label="Memberships"><h4>Memberships</h4><ul class="governance-list"><li><span>Teacher · Teacher · Active</span><button>Revoke</button></li></ul><form><label>Account<select name="userId"><option value="user:a">Teacher</option><option value="user:b">Teacher</option></select></label><button type="submit">Add or reactivate</button></form></section><section class="governance-exchange" aria-label="Class exchange"><h4>Class exchange</h4><button>Export</button><label>Exported package<textarea readOnly="" rows="6">{
  &quot;format&quot;: &quot;marea-class-exchange:1&quot;,
  &quot;source&quot;: {
    &quot;displayName&quot;: &quot;Source class&quot;
  },
  &quot;agentMode&quot;: &quot;tutoring&quot;,
  &quot;classInstructions&quot;: {
    &quot;tutoring&quot;: &quot;Teach&quot;,
    &quot;free&quot;: &quot;Explore&quot;
  },
  &quot;selection&quot;: {
    &quot;didactic&quot;: [],
    &quot;evaluation&quot;: []
  }
}</textarea></label><form><label>Package to import<textarea name="importText" rows="6" maxLength="1048576"></textarea></label><button type="submit">Stage package</button></form><div class="governance-staged"><p>Source class</p><button>Preview import</button><button>Clear package</button></div><div class="governance-preview" role="region" aria-label="Import preview"><h5>Import preview</h5><dl><dt>Agent mode</dt><dd>tutoring</dd><dt>Instructions</dt><dd>Teach</dd></dl><p>0 didactic and 0 evaluation skills</p><p>The destination evaluation policy is kept.</p><p><time dateTime="2099-01-01T00:00:00.000Z">Expires at 2099-01-01T00:00:00.000Z</time></p><button>Confirm import</button><button>Cancel preview</button></div></section></div></section><section class="governance-accounts" aria-label="Accounts"><h3>Accounts</h3><ul class="governance-list"><li><span>Teacher · Teacher · Active</span><button aria-current="true">Open</button></li><li><span>Teacher · Teacher · Active</span><button>Open</button></li></ul><form class="governance-create"><label>User ID<input maxLength="128" name="userId"/></label><label>Display name<input maxLength="120" name="displayName"/></label><label>Login<input maxLength="64" autoComplete="off" name="login"/></label><label>Role<select name="role"><option value="student" selected="">Student</option><option value="teacher">Teacher</option></select></label><label>Initial class<select name="classId"><option value="" selected="">None</option><option value="class:a">Physics</option><option value="class:b">Physics</option></select></label><button type="submit">Create</button></form><div class="governance-pending-creates"><h4>Unconfirmed creations</h4><ul><li><span>user:c · Pending account</span><button>Show</button><button>Retry</button><button>Discard</button></li></ul></div><div class="governance-selected"><form class="governance-rename"><label>Display name<input maxLength="120" name="displayName" value="Teacher"/></label><button type="submit">Save name</button></form><p>State: Active</p><button>Disable</button><button>End sessions</button><p><time dateTime="2099-01-01T00:00:00Z">Sessions ended at 2099-01-01T00:00:00Z</time></p></div></section></div></section>"
`;

