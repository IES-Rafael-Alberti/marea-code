exports[`groups optional credentials with plugin help and can explicitly clear stored group secrets > grouped optional credentials 1`] = `"<fieldset><legend>External account sign-in (optional)</legend><p>Configure your application with the identity provider first. You can then grant student access in the class settings.</p><section class="identity-connection"><label class="setup-choice"><input type="checkbox" checked=""/>School identity</label><div class="setup-grid"><details class="provider-help"><summary>Optional</summary><ol><li>Optional</li></ol></details><label>domain<input required="" autoComplete="off" maxLength="16384" type="text" value=""/></label><label>clientId<input required="" autoComplete="off" maxLength="16384" type="text" value="keep"/></label><label>clientSecret<details class="saved-secret"><summary>Key saved · Change</summary><span class="secret-control"><input autoComplete="off" maxLength="16384" type="password" aria-label="clientSecret" value=""/><button type="button" aria-label="Show or hide: clientSecret" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span></details></label><details class="identity-options"><summary>Group setup</summary><ol><li>Optional</li></ol><label>Optional<input autoComplete="off" maxLength="16384" type="url" value="https://idp.test"/></label><label>PEM<details class="saved-secret"><summary>Key saved · Change</summary><span class="secret-control"><textarea autoComplete="off" maxLength="16384" aria-label="PEM" class="secret-textarea"></textarea><button type="button" aria-label="Show or hide: PEM" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span></details></label><button type="button">Remove this optional configuration</button></details><details class="identity-options"><summary>Optional</summary><ol><li>Optional</li></ol><label>Optional<textarea autoComplete="off" maxLength="16384"></textarea></label><button type="button">Remove this optional configuration</button></details></div></section></fieldset>"`;

exports[`shows nothing without installed plugins and offers only their declared localized fields > enabled identity fields 1`] = `"<fieldset><legend>External account sign-in (optional)</legend><p>Configure your application with the identity provider first. You can then grant student access in the class settings.</p><section class="identity-connection"><label class="setup-choice"><input type="checkbox" checked=""/>School identity</label><div class="setup-grid"><label>domain<input required="" autoComplete="off" maxLength="16384" type="text" value=""/></label><label>clientId<input required="" autoComplete="off" maxLength="16384" type="text" value=""/></label><label>clientSecret<span class="secret-control"><input required="" autoComplete="off" maxLength="16384" type="password" aria-label="clientSecret" value=""/><button type="button" aria-label="Show or hide: clientSecret" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span></label><details><summary>More options</summary><label>Optional<input autoComplete="off" maxLength="16384" type="url" value="https://idp.test"/></label><label>PEM<span class="secret-control"><textarea autoComplete="off" maxLength="16384" aria-label="PEM" class="secret-textarea"></textarea><button type="button" aria-label="Show or hide: PEM" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span></label></details></div></section></fieldset>"`;
