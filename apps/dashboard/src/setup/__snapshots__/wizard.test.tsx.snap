// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders complete localized forms and keeps browser validation attributes > en step 0 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Welcome to Marea Code</h1><p>Get your first class ready to work. You can change these settings later.</p><label>Language<select><option value="es">Español</option><option value="en" selected="">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li aria-current="step">Your school</li><li>Connection and model</li><li>Classroom access</li><li>Ready to start</li></ol><form aria-busy="false"><fieldset><legend>Your school</legend><div class="setup-grid"><label>School name<input required="" maxLength="120" minLength="1" autoComplete="off" value=""/></label><label>First class<input required="" maxLength="120" minLength="1" autoComplete="off" value=""/></label><label>Your name<input required="" maxLength="120" minLength="1" autoComplete="off" value=""/></label><label>Dashboard username<input required="" maxLength="64" minLength="3" pattern="[a-z0-9][a-z0-9._-]*" autoComplete="username" value="profe"/></label><label>Password<input required="" type="password" autoComplete="new-password" minLength="12" maxLength="256" value=""/></label><label>Repeat the password<input required="" type="password" autoComplete="new-password" minLength="12" maxLength="256" value=""/></label><p>Between 12 and 256 characters.</p></div><div class="setup-actions"><button type="submit">Continue</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > en step 1 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Welcome to Marea Code</h1><p>Get your first class ready to work. You can change these settings later.</p><label>Language<select><option value="es">Español</option><option value="en" selected="">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Your school</li><li aria-current="step">Connection and model</li><li>Classroom access</li><li>Ready to start</li></ol><form aria-busy="false"><fieldset><legend>Connection and model</legend><div class="server-settings"><p>Enter your provider key and choose the model students will use. The connection will be checked and its prices filled in.</p><h3>1. Provider connections</h3><p class="server-help">Credentials belong to the server and are never shown again after saving. Entering a key checks the connection and loads available models.</p><details class="workspace-advanced" open=""><summary>Provider</summary><label><input type="checkbox" disabled="" checked=""/>Enable connection</label><p class="server-help">Used by a configured route: it cannot be disabled.</p><p role="status">Connection verified · Available models (0)<button type="button">Check again</button></p></details><h3>2. Model for sessions</h3><p class="server-help">The main model serves tutoring and, unless you choose another, evaluation.</p><label class="server-field">Provider<select><option value="" disabled="">Provider</option><option value="org.marea.openrouter" selected="">Provider</option></select></label><label class="server-field">Main model<input required="" list="models-tutoring" value="synthetic/classroom"/><datalist id="models-tutoring"></datalist></label><div class="server-common" data-active="true"><p>New sessions in every class will use this model.</p></div><h3>3. Limits and prices</h3><p class="server-help">Usage is unlimited by default. Choosing a catalog model fills its editable prices. If you type a different model, review prices manually. Prices are estimates and exclude discounts and caching.</p><details class="workspace-advanced"><summary>Tutoring · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Unlimited usage</label><label>Units per input token<input type="number" min="0" step="1" required="" value="0"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="0"/></label><label>Cost unit<input required="" value="units"/></label></div></details><details class="workspace-advanced"><summary>Evaluation · Usage limits</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Unlimited usage</label><label>Units per input token<input type="number" min="0" step="1" required="" value="0"/></label><label>Units per output token<input type="number" min="0" step="1" required="" value="0"/></label><label>Cost unit<input required="" value="units"/></label></div></details><details class="workspace-advanced"><summary>Models and limits by task</summary><fieldset><legend>Evaluation</legend><label class="server-field">Main model<input required="" list="models-evaluation" value="synthetic/classroom"/><datalist id="models-evaluation"></datalist></label><label class="server-field">Provider<select><option value="org.marea.openrouter" selected="">Provider</option></select></label></fieldset><fieldset><legend>Map · per class and day</legend><label><input type="checkbox"/>Configure this feature</label></fieldset><fieldset><legend>Reports · per attempt</legend><label><input type="checkbox"/>Configure this feature</label></fieldset></details></div><div class="setup-actions"><button type="button">Back</button><button type="submit">Continue</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > en step 2 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Welcome to Marea Code</h1><p>Get your first class ready to work. You can change these settings later.</p><label>Language<select><option value="es">Español</option><option value="en" selected="">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Your school</li><li>Connection and model</li><li aria-current="step">Classroom access</li><li>Ready to start</li></ol><form aria-busy="false"><fieldset><legend>Classroom access</legend><fieldset><legend>Where will students connect from?</legend><label class="setup-choice"><input type="radio" name="access" value="local"/>Only this computer</label><label class="setup-choice"><input type="radio" name="access" checked="" value="lan"/>The classroom local network (HTTP)</label><label class="setup-choice"><input type="radio" name="access" value="https"/>An HTTPS address</label><p>HTTP works on a trusted local network. HTTPS requires an address with a configured proxy.</p></fieldset><label>Server port<input required="" type="number" min="1024" max="65535" value="18787"/></label><label class="setup-choice"><input type="checkbox"/>Set up Google Workspace sign-in (optional)</label><label class="setup-choice"><input type="checkbox"/>Enable the example skill for learning to write tests (optional)</label><div class="setup-actions"><button type="button">Back</button><button type="submit">Continue</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > en step 3 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Welcome to Marea Code</h1><p>Get your first class ready to work. You can change these settings later.</p><label>Language<select><option value="es">Español</option><option value="en" selected="">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Your school</li><li>Connection and model</li><li>Classroom access</li><li aria-current="step">Ready to start</li></ol><form aria-busy="false"><fieldset><legend>Ready to start</legend><dl class="setup-review"><dt>School name</dt><dd></dd><dt>First class</dt><dd></dd><dt>Your name</dt><dd> (profe)</dd><dt>Connection and model</dt><dd>synthetic/classroom</dd><dt>Where will students connect from?</dt><dd>The classroom local network (HTTP)</dd></dl><p>The class will be saved in tutoring mode, with the selected limits and project changes requiring the student&#x27;s approval.</p><p>Google and the example skill are optional. Automatic evaluation can be configured later.</p><div class="setup-actions"><button type="button">Back</button><button type="submit">Create school and open dashboard</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > es step 0 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Bienvenido a Marea Code</h1><p>Deja tu primera clase lista para trabajar. Podrás cambiar estos ajustes después.</p><label>Idioma<select><option value="es" selected="">Español</option><option value="en">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li aria-current="step">Tu centro</li><li>Conexión y modelo</li><li>Acceso al aula</li><li>Todo listo</li></ol><form aria-busy="false"><fieldset><legend>Tu centro</legend><div class="setup-grid"><label>Nombre del centro<input required="" maxLength="120" minLength="1" autoComplete="off" value=""/></label><label>Primera clase<input required="" maxLength="120" minLength="1" autoComplete="off" value=""/></label><label>Tu nombre<input required="" maxLength="120" minLength="1" autoComplete="off" value=""/></label><label>Usuario para entrar al panel<input required="" maxLength="64" minLength="3" pattern="[a-z0-9][a-z0-9._-]*" autoComplete="username" value="profe"/></label><label>Contraseña<input required="" type="password" autoComplete="new-password" minLength="12" maxLength="256" value=""/></label><label>Repite la contraseña<input required="" type="password" autoComplete="new-password" minLength="12" maxLength="256" value=""/></label><p>Entre 12 y 256 caracteres.</p></div><div class="setup-actions"><button type="submit">Continuar</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > es step 1 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Bienvenido a Marea Code</h1><p>Deja tu primera clase lista para trabajar. Podrás cambiar estos ajustes después.</p><label>Idioma<select><option value="es" selected="">Español</option><option value="en">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Tu centro</li><li aria-current="step">Conexión y modelo</li><li>Acceso al aula</li><li>Todo listo</li></ol><form aria-busy="false"><fieldset><legend>Conexión y modelo</legend><div class="server-settings"><p>Introduce la clave de tu proveedor y elige el modelo que usará el alumnado. Se comprobará la conexión y se completarán sus precios.</p><h3>1. Conexiones con proveedores</h3><p class="server-help">Las credenciales pertenecen al servidor y nunca se muestran después de guardarlas. Al introducir la clave se comprueba la conexión y se consultan los modelos disponibles.</p><details class="workspace-advanced" open=""><summary>Provider</summary><label><input type="checkbox" disabled="" checked=""/>Habilitar conexión</label><p class="server-help">En uso por una ruta configurada: no se puede deshabilitar.</p><p role="status">Conexión comprobada · Modelos disponibles (0)<button type="button">Volver a comprobar</button></p></details><h3>2. Modelo para las sesiones</h3><p class="server-help">El modelo principal atiende la tutoría y, salvo que indiques otro, la evaluación.</p><label class="server-field">Proveedor<select><option value="" disabled="">Proveedor</option><option value="org.marea.openrouter" selected="">Provider</option></select></label><label class="server-field">Modelo principal<input required="" list="models-tutoring" value="synthetic/classroom"/><datalist id="models-tutoring"></datalist></label><div class="server-common" data-active="true"><p>Las sesiones nuevas de todas las clases usarán este modelo.</p></div><h3>3. Límites y precios</h3><p class="server-help">Por defecto no hay límites de uso. Al elegir un modelo del catálogo se rellenan sus precios, que puedes editar. Si escribes otro modelo, revisa los precios manualmente. Las tarifas son estimaciones y no incluyen descuentos ni caché.</p><details class="workspace-advanced"><summary>Tutoría · Límites de uso</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Sin límites de uso</label><label>Unidades por token de entrada<input type="number" min="0" step="1" required="" value="0"/></label><label>Unidades por token de salida<input type="number" min="0" step="1" required="" value="0"/></label><label>Unidad de coste<input required="" value="units"/></label></div></details><details class="workspace-advanced"><summary>Evaluación · Límites de uso</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Sin límites de uso</label><label>Unidades por token de entrada<input type="number" min="0" step="1" required="" value="0"/></label><label>Unidades por token de salida<input type="number" min="0" step="1" required="" value="0"/></label><label>Unidad de coste<input required="" value="units"/></label></div></details><details class="workspace-advanced"><summary>Modelos y límites por tarea</summary><fieldset><legend>Evaluación</legend><label class="server-field">Modelo principal<input required="" list="models-evaluation" value="synthetic/classroom"/><datalist id="models-evaluation"></datalist></label><label class="server-field">Proveedor<select><option value="org.marea.openrouter" selected="">Provider</option></select></label></fieldset><fieldset><legend>Mapa · por clase y día</legend><label><input type="checkbox"/>Configurar esta función</label></fieldset><fieldset><legend>Informes · por intento</legend><label><input type="checkbox"/>Configurar esta función</label></fieldset></details></div><div class="setup-actions"><button type="button">Atrás</button><button type="submit">Continuar</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > es step 2 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Bienvenido a Marea Code</h1><p>Deja tu primera clase lista para trabajar. Podrás cambiar estos ajustes después.</p><label>Idioma<select><option value="es" selected="">Español</option><option value="en">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Tu centro</li><li>Conexión y modelo</li><li aria-current="step">Acceso al aula</li><li>Todo listo</li></ol><form aria-busy="false"><fieldset><legend>Acceso al aula</legend><fieldset><legend>¿Desde dónde se conectará el alumnado?</legend><label class="setup-choice"><input type="radio" name="access" value="local"/>Solo desde este ordenador</label><label class="setup-choice"><input type="radio" name="access" checked="" value="lan"/>Desde la red local del aula (HTTP)</label><label class="setup-choice"><input type="radio" name="access" value="https"/>Desde una dirección HTTPS</label><p>HTTP permite trabajar en una red local de confianza. Para HTTPS necesitas una dirección con un proxy ya configurado.</p></fieldset><label>Puerto del servidor<input required="" type="number" min="1024" max="65535" value="18787"/></label><label class="setup-choice"><input type="checkbox"/>Configurar acceso con Google Workspace (opcional)</label><label class="setup-choice"><input type="checkbox"/>Activar la skill de ejemplo para aprender a escribir tests (opcional)</label><div class="setup-actions"><button type="button">Atrás</button><button type="submit">Continuar</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > es step 3 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Bienvenido a Marea Code</h1><p>Deja tu primera clase lista para trabajar. Podrás cambiar estos ajustes después.</p><label>Idioma<select><option value="es" selected="">Español</option><option value="en">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Tu centro</li><li>Conexión y modelo</li><li>Acceso al aula</li><li aria-current="step">Todo listo</li></ol><form aria-busy="false"><fieldset><legend>Todo listo</legend><dl class="setup-review"><dt>Nombre del centro</dt><dd></dd><dt>Primera clase</dt><dd></dd><dt>Tu nombre</dt><dd> (profe)</dd><dt>Conexión y modelo</dt><dd>synthetic/classroom</dd><dt>¿Desde dónde se conectará el alumnado?</dt><dd>Desde la red local del aula (HTTP)</dd></dl><p>Se guardará la clase en modo tutoría, con los límites elegidos y las modificaciones del proyecto sujetas a la aprobación del alumno.</p><p>Google y la skill de ejemplo son opcionales. La evaluación automática se puede configurar más adelante.</p><div class="setup-actions"><button type="button">Atrás</button><button type="submit">Crear centro y abrir el panel</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > eu step 0 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Ongi etorri Marea Code-ra</h1><p>Prestatu zure lehen klasea lanerako. Ezarpenak gero alda ditzakezu.</p><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li aria-current="step">Zure ikastetxea</li><li>Konexioa eta modeloa</li><li>Ikasgelarako sarbidea</li><li>Hasteko prest</li></ol><form aria-busy="false"><fieldset><legend>Zure ikastetxea</legend><div class="setup-grid"><label>Ikastetxearen izena<input required="" maxLength="120" minLength="1" autoComplete="off" value=""/></label><label>Lehen klasea<input required="" maxLength="120" minLength="1" autoComplete="off" value=""/></label><label>Zure izena<input required="" maxLength="120" minLength="1" autoComplete="off" value=""/></label><label>Paneleko erabiltzaile-izena<input required="" maxLength="64" minLength="3" pattern="[a-z0-9][a-z0-9._-]*" autoComplete="username" value="profe"/></label><label>Pasahitza<input required="" type="password" autoComplete="new-password" minLength="12" maxLength="256" value=""/></label><label>Errepikatu pasahitza<input required="" type="password" autoComplete="new-password" minLength="12" maxLength="256" value=""/></label><p>12 eta 256 karaktere artean.</p></div><div class="setup-actions"><button type="submit">Jarraitu</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > eu step 1 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Ongi etorri Marea Code-ra</h1><p>Prestatu zure lehen klasea lanerako. Ezarpenak gero alda ditzakezu.</p><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li>Zure ikastetxea</li><li aria-current="step">Konexioa eta modeloa</li><li>Ikasgelarako sarbidea</li><li>Hasteko prest</li></ol><form aria-busy="false"><fieldset><legend>Konexioa eta modeloa</legend><div class="server-settings"><p>Sartu hornitzailearen gakoa eta aukeratu ikasleek erabiliko duten modeloa. Konexioa egiaztatu eta prezioak beteko dira.</p><h3>1. Hornitzaileekiko konexioak</h3><p class="server-help">Kredentzialak zerbitzariarenak dira eta gorde ondoren ez dira berriro erakusten. Gakoa sartzean konexioa egiaztatu eta erabilgarri dauden ereduak kargatzen dira.</p><details class="workspace-advanced" open=""><summary>Provider</summary><label><input type="checkbox" disabled="" checked=""/>Gaitu konexioa</label><p class="server-help">Konfiguratutako ibilbide batek erabiltzen du: ezin da desgaitu.</p><p role="status">Konexioa egiaztatuta · Eredu erabilgarriak (0)<button type="button">Egiaztatu berriro</button></p></details><h3>2. Saioetarako eredua</h3><p class="server-help">Eredu nagusiak tutoretza eta, beste bat aukeratu ezean, ebaluazioa egiten ditu.</p><label class="server-field">Hornitzailea<select><option value="" disabled="">Hornitzailea</option><option value="org.marea.openrouter" selected="">Provider</option></select></label><label class="server-field">Eredu nagusia<input required="" list="models-tutoring" value="synthetic/classroom"/><datalist id="models-tutoring"></datalist></label><div class="server-common" data-active="true"><p>Ikasgela guztietako saio berriek eredu hau erabiliko dute.</p></div><h3>3. Mugak eta prezioak</h3><p class="server-help">Lehenespenez ez dago erabilera mugarik. Katalogoko eredu bat aukeratzean prezio editagarriak betetzen dira. Beste eredu bat idatziz gero, berrikusi prezioak eskuz. Prezioak estimazioak dira; deskontuak eta cachea ez dira sartzen.</p><details class="workspace-advanced"><summary>Tutoretza · Erabilera mugak</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Erabilera mugagabea</label><label>Unitateak sarrerako token bakoitzeko<input type="number" min="0" step="1" required="" value="0"/></label><label>Unitateak irteerako token bakoitzeko<input type="number" min="0" step="1" required="" value="0"/></label><label>Kostu unitatea<input required="" value="units"/></label></div></details><details class="workspace-advanced"><summary>Ebaluazioa · Erabilera mugak</summary><div class="server-settings-fields"><label><input type="checkbox" checked=""/>Erabilera mugagabea</label><label>Unitateak sarrerako token bakoitzeko<input type="number" min="0" step="1" required="" value="0"/></label><label>Unitateak irteerako token bakoitzeko<input type="number" min="0" step="1" required="" value="0"/></label><label>Kostu unitatea<input required="" value="units"/></label></div></details><details class="workspace-advanced"><summary>Ereduak eta mugak zereginaren arabera</summary><fieldset><legend>Ebaluazioa</legend><label class="server-field">Eredu nagusia<input required="" list="models-evaluation" value="synthetic/classroom"/><datalist id="models-evaluation"></datalist></label><label class="server-field">Hornitzailea<select><option value="org.marea.openrouter" selected="">Provider</option></select></label></fieldset><fieldset><legend>Mapa · ikasgelako eta eguneko</legend><label><input type="checkbox"/>Konfiguratu funtzio hau</label></fieldset><fieldset><legend>Txostenak · saiakerako</legend><label><input type="checkbox"/>Konfiguratu funtzio hau</label></fieldset></details></div><div class="setup-actions"><button type="button">Atzera</button><button type="submit">Jarraitu</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > eu step 2 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Ongi etorri Marea Code-ra</h1><p>Prestatu zure lehen klasea lanerako. Ezarpenak gero alda ditzakezu.</p><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li>Zure ikastetxea</li><li>Konexioa eta modeloa</li><li aria-current="step">Ikasgelarako sarbidea</li><li>Hasteko prest</li></ol><form aria-busy="false"><fieldset><legend>Ikasgelarako sarbidea</legend><fieldset><legend>Nondik konektatuko dira ikasleak?</legend><label class="setup-choice"><input type="radio" name="access" value="local"/>Ordenagailu honetatik soilik</label><label class="setup-choice"><input type="radio" name="access" checked="" value="lan"/>Ikasgelako sare lokaletik (HTTP)</label><label class="setup-choice"><input type="radio" name="access" value="https"/>HTTPS helbide batetik</label><p>HTTP konfiantzazko sare lokal batean erabil daiteke. HTTPS erabiltzeko proxy bat konfiguratutako helbidea behar da.</p></fieldset><label>Zerbitzariaren ataka<input required="" type="number" min="1024" max="65535" value="18787"/></label><label class="setup-choice"><input type="checkbox"/>Konfiguratu Google Workspace sarbidea (aukerakoa)</label><label class="setup-choice"><input type="checkbox"/>Aktibatu testak idazten ikasteko adibide-skilla (aukerakoa)</label><div class="setup-actions"><button type="button">Atzera</button><button type="submit">Jarraitu</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > eu step 3 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Ongi etorri Marea Code-ra</h1><p>Prestatu zure lehen klasea lanerako. Ezarpenak gero alda ditzakezu.</p><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li>Zure ikastetxea</li><li>Konexioa eta modeloa</li><li>Ikasgelarako sarbidea</li><li aria-current="step">Hasteko prest</li></ol><form aria-busy="false"><fieldset><legend>Hasteko prest</legend><dl class="setup-review"><dt>Ikastetxearen izena</dt><dd></dd><dt>Lehen klasea</dt><dd></dd><dt>Zure izena</dt><dd> (profe)</dd><dt>Konexioa eta modeloa</dt><dd>synthetic/classroom</dd><dt>Nondik konektatuko dira ikasleak?</dt><dd>Ikasgelako sare lokaletik (HTTP)</dd></dl><p>Klasea tutoretza moduan gordeko da, hautatutako mugekin eta proiektuko aldaketetarako ikaslearen onespena eskatuta.</p><p>Google eta adibide-skilla aukerakoak dira. Ebaluazio automatikoa gero konfigura daiteke.</p><div class="setup-actions"><button type="button">Atzera</button><button type="submit">Sortu ikastetxea eta ireki panela</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > optional Google and HTTPS 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Ongi etorri Marea Code-ra</h1><p>Prestatu zure lehen klasea lanerako. Ezarpenak gero alda ditzakezu.</p><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li>Zure ikastetxea</li><li>Konexioa eta modeloa</li><li aria-current="step">Ikasgelarako sarbidea</li><li>Hasteko prest</li></ol><form aria-busy="false"><fieldset><legend>Ikasgelarako sarbidea</legend><fieldset><legend>Nondik konektatuko dira ikasleak?</legend><label class="setup-choice"><input type="radio" name="access" value="local"/>Ordenagailu honetatik soilik</label><label class="setup-choice"><input type="radio" name="access" value="lan"/>Ikasgelako sare lokaletik (HTTP)</label><label class="setup-choice"><input type="radio" name="access" checked="" value="https"/>HTTPS helbide batetik</label><p>HTTP konfiantzazko sare lokal batean erabil daiteke. HTTPS erabiltzeko proxy bat konfiguratutako helbidea behar da.</p></fieldset><label>Zerbitzariaren ataka<input required="" type="number" min="1024" max="65535" value="18793"/></label><label>HTTPS helbide publikoa<input required="" type="url" pattern="https://.*" placeholder="https://marea.example.edu" value=""/></label><label class="setup-choice"><input type="checkbox" checked=""/>Konfiguratu Google Workspace sarbidea (aukerakoa)</label><fieldset class="setup-grid"><legend>Google Workspace</legend><p>Google aplikazioa zure domeinuan baimenduta egon behar da. Ondoren, gehitu ikasleen helbide elektronikoak klasearen ezarpenetan.</p><label>Ikastetxearen domeinua<input required="" type="text" autoComplete="off" value=""/></label><label>Mahaigaineko OAuth bezeroaren IDa<input required="" type="text" autoComplete="off" value=""/></label><label>OAuth bezeroaren sekretua<input required="" type="password" autoComplete="off" value=""/></label></fieldset><label class="setup-choice"><input type="checkbox"/>Aktibatu testak idazten ikasteko adibide-skilla (aukerakoa)</label><div class="setup-actions"><button type="button">Atzera</button><button type="submit">Jarraitu</button></div></fieldset></form></main>"`;

