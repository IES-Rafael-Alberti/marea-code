exports[`renders complete localized forms and keeps browser validation attributes > en step 0 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Prepare your first class</h1><label>Language<select><option value="es">Español</option><option value="en" selected="">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li aria-current="step">Your class</li><li>Connect a model</li><li>Give students access</li><li>Optional features</li><li>Review and start</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Your class</legend><div class="setup-grid"><h2 class="form-group-title">School and class</h2><label>School name<input required="" aria-describedby="setup-center-error" maxLength="120" minLength="1" autoComplete="off" value=""/><span id="setup-center-error" class="field-error" aria-live="polite"></span></label><label>Name of your first class<input required="" aria-describedby="setup-classroom-error" maxLength="120" minLength="1" autoComplete="off" value=""/><span id="setup-classroom-error" class="field-error" aria-live="polite"></span></label><h2 class="form-group-title">Your teacher account</h2><label>Your name<input required="" aria-describedby="setup-teacher-error" maxLength="120" minLength="1" autoComplete="off" value=""/><span id="setup-teacher-error" class="field-error" aria-live="polite"></span></label><label>Dashboard username<input required="" aria-describedby="setup-login-error" maxLength="64" minLength="3" pattern="[a-z0-9][a-z0-9._-]*" autoComplete="username" value="profe"/><span id="setup-login-error" class="field-error" aria-live="polite"></span></label><label>Password<span class="secret-control"><input required="" autoComplete="new-password" minLength="12" maxLength="256" aria-describedby="setup-password-error" type="password" aria-label="Password" value=""/><button type="button" aria-label="Show or hide: Password" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span><span id="setup-password-error" class="field-error" aria-live="polite"></span></label><label>Repeat the password<span class="secret-control"><input required="" autoComplete="new-password" minLength="12" maxLength="256" aria-describedby="setup-confirmation-error" type="password" aria-label="Repeat the password" value=""/><button type="button" aria-label="Show or hide: Repeat the password" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span><span id="setup-confirmation-error" class="field-error" aria-live="polite"></span></label></div><div class="setup-actions"><button type="submit">Continue</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > en step 1 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Connect a model</h1><label>Language<select><option value="es">Español</option><option value="en" selected="">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Your class</li><li aria-current="step">Connect a model</li><li>Give students access</li><li>Optional features</li><li>Review and start</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Connect a model</legend><div class="server-settings"><p>Enter your key and find the model students will use.</p><section class="workspace-advanced"><h2>Provider</h2><div role="status" class="connection-status">Connection verified · Available models (0)<button type="button">Check again</button></div></section><div data-settings-section="models"><label class="server-field">Main model<input required="" list="models-tutoring" value="synthetic/classroom"/><datalist id="models-tutoring"></datalist></label></div></div><div class="setup-actions"><button type="button">Back</button><button type="submit">Continue</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > en step 2 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Give students access</h1><label>Language<select><option value="es">Español</option><option value="en" selected="">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Your class</li><li>Connect a model</li><li aria-current="step">Give students access</li><li>Optional features</li><li>Review and start</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Give students access</legend><fieldset><legend>Where will students connect from?</legend><label class="setup-choice"><input type="radio" name="access" checked="" value="lan"/>The classroom local network (HTTP)</label><label class="setup-choice"><input type="radio" name="access" value="local"/>Only this computer</label><label class="setup-choice"><input type="radio" name="access" value="https"/>An HTTPS address</label><div class="setup-address"><p role="status">No network address detected. Connect this computer to the classroom network before sharing the installer.</p></div><p class="server-help">HTTP works on a trusted local network. HTTPS requires an address with a configured proxy.</p></fieldset><details class="connection-options"><summary>Connection options</summary><label>Server port<input required="" type="number" min="1024" max="65535" value="18787"/></label></details><fieldset><legend>External account sign-in (optional)</legend><p>Configure your application with the identity provider first. You can then grant student access in the class settings.</p><section class="identity-connection"><label class="setup-choice"><input type="checkbox"/>School identity</label></section></fieldset><div class="setup-actions"><button type="button">Back</button><button type="submit">Continue</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > en step 3 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Optional features</h1><label>Language<select><option value="es">Español</option><option value="en" selected="">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Your class</li><li>Connect a model</li><li>Give students access</li><li aria-current="step">Optional features</li><li>Review and start</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Optional features</legend><div class="setup-features"><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Attention map</label><p>Helps identify students who may need your attention during class.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Class reports</label><p>Summarizes session evidence and difficulties for your review.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Automatic evaluation</label><p>When a session closes, prepares a draft for you to review before sharing.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Example skill: learning to write tests</label><p>Includes example goals and criteria for learning to test code. You can inspect and adapt it later.</p></section><p class="server-help">The map, reports and evaluation make additional requests to the chosen model. You can change their models and set limits in Settings → Server.</p></div><div class="setup-actions"><button type="button">Back</button><button type="button">Skip for now</button><button type="submit">Continue</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > en step 4 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Review and start</h1><label>Language<select><option value="es">Español</option><option value="en" selected="">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Your class</li><li>Connect a model</li><li>Give students access</li><li>Optional features</li><li aria-current="step">Review and start</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Review and start</legend><dl class="setup-review"><div><dt>School and class</dt><dd> · </dd><dd><button type="button" aria-label="Change: School and class">Change</button></dd></div><div><dt>Your teacher account</dt><dd> (profe)</dd><dd><button type="button" aria-label="Change: Your teacher account">Change</button></dd></div><div><dt>Connect a model</dt><dd>synthetic/classroom</dd><dd><button type="button" aria-label="Change: Connect a model">Change</button></dd></div><div><dt>Where will students connect from?</dt><dd>The classroom local network (HTTP)</dd><dd><button type="button" aria-label="Change: Where will students connect from?">Change</button></dd></div><div><dt>Optional features</dt><dd>None for now</dd><dd><button type="button" aria-label="Change: Optional features">Change</button></dd></div></dl><p>The class will be saved in tutoring mode, without usage limits and project changes requiring the student&#x27;s approval.</p><div class="setup-actions"><button type="button">Back</button><button type="submit">Open my class</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > es step 0 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Prepara tu primera clase</h1><label>Idioma<select><option value="es" selected="">Español</option><option value="en">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li aria-current="step">Tu clase</li><li>Conecta un modelo</li><li>Da acceso al alumnado</li><li>Funciones opcionales</li><li>Revisa y empieza</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Tu clase</legend><div class="setup-grid"><h2 class="form-group-title">Centro y clase</h2><label>Nombre del centro<input required="" aria-describedby="setup-center-error" maxLength="120" minLength="1" autoComplete="off" value=""/><span id="setup-center-error" class="field-error" aria-live="polite"></span></label><label>Nombre de tu primera clase<input required="" aria-describedby="setup-classroom-error" maxLength="120" minLength="1" autoComplete="off" value=""/><span id="setup-classroom-error" class="field-error" aria-live="polite"></span></label><h2 class="form-group-title">Tu cuenta de profesor</h2><label>Tu nombre<input required="" aria-describedby="setup-teacher-error" maxLength="120" minLength="1" autoComplete="off" value=""/><span id="setup-teacher-error" class="field-error" aria-live="polite"></span></label><label>Usuario para entrar al panel<input required="" aria-describedby="setup-login-error" maxLength="64" minLength="3" pattern="[a-z0-9][a-z0-9._-]*" autoComplete="username" value="profe"/><span id="setup-login-error" class="field-error" aria-live="polite"></span></label><label>Contraseña<span class="secret-control"><input required="" autoComplete="new-password" minLength="12" maxLength="256" aria-describedby="setup-password-error" type="password" aria-label="Contraseña" value=""/><button type="button" aria-label="Mostrar u ocultar: Contraseña" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span><span id="setup-password-error" class="field-error" aria-live="polite"></span></label><label>Repite la contraseña<span class="secret-control"><input required="" autoComplete="new-password" minLength="12" maxLength="256" aria-describedby="setup-confirmation-error" type="password" aria-label="Repite la contraseña" value=""/><button type="button" aria-label="Mostrar u ocultar: Repite la contraseña" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span><span id="setup-confirmation-error" class="field-error" aria-live="polite"></span></label></div><div class="setup-actions"><button type="submit">Continuar</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > es step 1 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Conecta un modelo</h1><label>Idioma<select><option value="es" selected="">Español</option><option value="en">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Tu clase</li><li aria-current="step">Conecta un modelo</li><li>Da acceso al alumnado</li><li>Funciones opcionales</li><li>Revisa y empieza</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Conecta un modelo</legend><div class="server-settings"><p>Introduce la clave y busca el modelo que usará el alumnado.</p><section class="workspace-advanced"><h2>Provider</h2><div role="status" class="connection-status">Conexión comprobada · Modelos disponibles (0)<button type="button">Volver a comprobar</button></div></section><div data-settings-section="models"><label class="server-field">Modelo principal<input required="" list="models-tutoring" value="synthetic/classroom"/><datalist id="models-tutoring"></datalist></label></div></div><div class="setup-actions"><button type="button">Atrás</button><button type="submit">Continuar</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > es step 2 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Da acceso al alumnado</h1><label>Idioma<select><option value="es" selected="">Español</option><option value="en">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Tu clase</li><li>Conecta un modelo</li><li aria-current="step">Da acceso al alumnado</li><li>Funciones opcionales</li><li>Revisa y empieza</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Da acceso al alumnado</legend><fieldset><legend>¿Desde dónde se conectará el alumnado?</legend><label class="setup-choice"><input type="radio" name="access" checked="" value="lan"/>Desde la red local del aula (HTTP)</label><label class="setup-choice"><input type="radio" name="access" value="local"/>Solo desde este ordenador</label><label class="setup-choice"><input type="radio" name="access" value="https"/>Desde una dirección HTTPS</label><div class="setup-address"><p role="status">No se ha detectado una dirección de red. Conecta este equipo a la red del aula antes de compartir el instalador.</p></div><p class="server-help">HTTP permite trabajar en una red local de confianza. Para HTTPS necesitas una dirección con un proxy ya configurado.</p></fieldset><details class="connection-options"><summary>Opciones de conexión</summary><label>Puerto del servidor<input required="" type="number" min="1024" max="65535" value="18787"/></label></details><fieldset><legend>Acceso con cuentas externas (opcional)</legend><p>Configura primero la aplicación en el proveedor de identidad. Después podrás dar acceso al alumnado desde los ajustes de la clase.</p><section class="identity-connection"><label class="setup-choice"><input type="checkbox"/>School identity</label></section></fieldset><div class="setup-actions"><button type="button">Atrás</button><button type="submit">Continuar</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > es step 3 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Funciones opcionales</h1><label>Idioma<select><option value="es" selected="">Español</option><option value="en">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Tu clase</li><li>Conecta un modelo</li><li>Da acceso al alumnado</li><li aria-current="step">Funciones opcionales</li><li>Revisa y empieza</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Funciones opcionales</legend><div class="setup-features"><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Mapa de atención</label><p>Ayuda a detectar quién puede necesitar tu atención durante la clase.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Informes de clase</label><p>Resume evidencias y dificultades de las sesiones para preparar tu revisión.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Evaluación automática</label><p>Al cerrar una sesión, prepara un borrador que tú revisas antes de compartirlo.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Skill de ejemplo: aprender a escribir tests</label><p>Incluye un ejemplo con objetivos y criterios para aprender a probar código. Podrás verlo y adaptarlo después.</p></section><p class="server-help">El mapa, los informes y la evaluación realizan consultas adicionales al modelo elegido. Puedes cambiar su modelo y fijar límites en Ajustes → Servidor.</p></div><div class="setup-actions"><button type="button">Atrás</button><button type="button">Omitir por ahora</button><button type="submit">Continuar</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > es step 4 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Revisa y empieza</h1><label>Idioma<select><option value="es" selected="">Español</option><option value="en">English</option><option value="eu">Euskara</option></select></label></header><ol class="setup-steps"><li>Tu clase</li><li>Conecta un modelo</li><li>Da acceso al alumnado</li><li>Funciones opcionales</li><li aria-current="step">Revisa y empieza</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Revisa y empieza</legend><dl class="setup-review"><div><dt>Centro y clase</dt><dd> · </dd><dd><button type="button" aria-label="Cambiar: Centro y clase">Cambiar</button></dd></div><div><dt>Tu cuenta de profesor</dt><dd> (profe)</dd><dd><button type="button" aria-label="Cambiar: Tu cuenta de profesor">Cambiar</button></dd></div><div><dt>Conecta un modelo</dt><dd>synthetic/classroom</dd><dd><button type="button" aria-label="Cambiar: Conecta un modelo">Cambiar</button></dd></div><div><dt>¿Desde dónde se conectará el alumnado?</dt><dd>Desde la red local del aula (HTTP)</dd><dd><button type="button" aria-label="Cambiar: ¿Desde dónde se conectará el alumnado?">Cambiar</button></dd></div><div><dt>Funciones opcionales</dt><dd>Ninguna por ahora</dd><dd><button type="button" aria-label="Cambiar: Funciones opcionales">Cambiar</button></dd></div></dl><p>Se guardará la clase en modo tutoría, sin límites de uso y las modificaciones del proyecto sujetas a la aprobación del alumno.</p><div class="setup-actions"><button type="button">Atrás</button><button type="submit">Abrir mi clase</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > eu step 0 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Prestatu zure lehen klasea</h1><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li aria-current="step">Zure klasea</li><li>Konektatu modelo bat</li><li>Eman ikasleei sarbidea</li><li>Aukerako funtzioak</li><li>Berrikusi eta hasi</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Zure klasea</legend><div class="setup-grid"><h2 class="form-group-title">Ikastetxea eta klasea</h2><label>Ikastetxearen izena<input required="" aria-describedby="setup-center-error" maxLength="120" minLength="1" autoComplete="off" value=""/><span id="setup-center-error" class="field-error" aria-live="polite"></span></label><label>Zure lehen klasearen izena<input required="" aria-describedby="setup-classroom-error" maxLength="120" minLength="1" autoComplete="off" value=""/><span id="setup-classroom-error" class="field-error" aria-live="polite"></span></label><h2 class="form-group-title">Zure irakasle-kontua</h2><label>Zure izena<input required="" aria-describedby="setup-teacher-error" maxLength="120" minLength="1" autoComplete="off" value=""/><span id="setup-teacher-error" class="field-error" aria-live="polite"></span></label><label>Paneleko erabiltzaile-izena<input required="" aria-describedby="setup-login-error" maxLength="64" minLength="3" pattern="[a-z0-9][a-z0-9._-]*" autoComplete="username" value="profe"/><span id="setup-login-error" class="field-error" aria-live="polite"></span></label><label>Pasahitza<span class="secret-control"><input required="" autoComplete="new-password" minLength="12" maxLength="256" aria-describedby="setup-password-error" type="password" aria-label="Pasahitza" value=""/><button type="button" aria-label="Erakutsi edo ezkutatu: Pasahitza" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span><span id="setup-password-error" class="field-error" aria-live="polite"></span></label><label>Errepikatu pasahitza<span class="secret-control"><input required="" autoComplete="new-password" minLength="12" maxLength="256" aria-describedby="setup-confirmation-error" type="password" aria-label="Errepikatu pasahitza" value=""/><button type="button" aria-label="Erakutsi edo ezkutatu: Errepikatu pasahitza" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span><span id="setup-confirmation-error" class="field-error" aria-live="polite"></span></label></div><div class="setup-actions"><button type="submit">Jarraitu</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > eu step 1 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Konektatu modelo bat</h1><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li>Zure klasea</li><li aria-current="step">Konektatu modelo bat</li><li>Eman ikasleei sarbidea</li><li>Aukerako funtzioak</li><li>Berrikusi eta hasi</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Konektatu modelo bat</legend><div class="server-settings"><p>Sartu gakoa eta bilatu ikasleek erabiliko duten modeloa.</p><section class="workspace-advanced"><h2>Provider</h2><div role="status" class="connection-status">Konexioa egiaztatuta · Eredu erabilgarriak (0)<button type="button">Egiaztatu berriro</button></div></section><div data-settings-section="models"><label class="server-field">Eredu nagusia<input required="" list="models-tutoring" value="synthetic/classroom"/><datalist id="models-tutoring"></datalist></label></div></div><div class="setup-actions"><button type="button">Atzera</button><button type="submit">Jarraitu</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > eu step 2 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Eman ikasleei sarbidea</h1><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li>Zure klasea</li><li>Konektatu modelo bat</li><li aria-current="step">Eman ikasleei sarbidea</li><li>Aukerako funtzioak</li><li>Berrikusi eta hasi</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Eman ikasleei sarbidea</legend><fieldset><legend>Nondik konektatuko dira ikasleak?</legend><label class="setup-choice"><input type="radio" name="access" checked="" value="lan"/>Ikasgelako sare lokaletik (HTTP)</label><label class="setup-choice"><input type="radio" name="access" value="local"/>Ordenagailu honetatik soilik</label><label class="setup-choice"><input type="radio" name="access" value="https"/>HTTPS helbide batetik</label><div class="setup-address"><p role="status">Ez da sare-helbiderik aurkitu. Konektatu ordenagailua ikasgelako sarera instalatzailea partekatu aurretik.</p></div><p class="server-help">HTTP konfiantzazko sare lokal batean erabil daiteke. HTTPS erabiltzeko proxy bat konfiguratutako helbidea behar da.</p></fieldset><details class="connection-options"><summary>Konexio-aukerak</summary><label>Zerbitzariaren ataka<input required="" type="number" min="1024" max="65535" value="18787"/></label></details><fieldset><legend>Kanpoko kontuekin sarbidea (aukerakoa)</legend><p>Konfiguratu aplikazioa identitate-hornitzailean. Ondoren, eman ikasleei sarbidea klasearen ezarpenetan.</p><section class="identity-connection"><label class="setup-choice"><input type="checkbox"/>School identity</label></section></fieldset><div class="setup-actions"><button type="button">Atzera</button><button type="submit">Jarraitu</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > eu step 3 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Aukerako funtzioak</h1><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li>Zure klasea</li><li>Konektatu modelo bat</li><li>Eman ikasleei sarbidea</li><li aria-current="step">Aukerako funtzioak</li><li>Berrikusi eta hasi</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Aukerako funtzioak</legend><div class="setup-features"><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Arreta-mapa</label><p>Klasean zure arreta behar dezaketen ikasleak identifikatzen laguntzen du.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Klaseko txostenak</label><p>Saioetako ebidentziak eta zailtasunak laburbiltzen ditu zure berrikuspenerako.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Ebaluazio automatikoa</label><p>Saioa ixtean, partekatu aurretik berrikusiko duzun zirriborroa prestatzen du.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox"/>Adibide-skilla: testak idazten ikastea</label><p>Kodea probatzen ikasteko helburu eta irizpideen adibidea dakar. Gero ikusi eta molda dezakezu.</p></section><p class="server-help">Mapak, txostenek eta ebaluazioak kontsulta gehigarriak egiten dizkiote modeloari. Modeloak eta mugak Ezarpenak → Zerbitzaria atalean alda ditzakezu.</p></div><div class="setup-actions"><button type="button">Atzera</button><button type="button">Saltatu oraingoz</button><button type="submit">Jarraitu</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > eu step 4 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Berrikusi eta hasi</h1><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li>Zure klasea</li><li>Konektatu modelo bat</li><li>Eman ikasleei sarbidea</li><li>Aukerako funtzioak</li><li aria-current="step">Berrikusi eta hasi</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Berrikusi eta hasi</legend><dl class="setup-review"><div><dt>Ikastetxea eta klasea</dt><dd> · </dd><dd><button type="button" aria-label="Aldatu: Ikastetxea eta klasea">Aldatu</button></dd></div><div><dt>Zure irakasle-kontua</dt><dd> (profe)</dd><dd><button type="button" aria-label="Aldatu: Zure irakasle-kontua">Aldatu</button></dd></div><div><dt>Konektatu modelo bat</dt><dd>synthetic/classroom</dd><dd><button type="button" aria-label="Aldatu: Konektatu modelo bat">Aldatu</button></dd></div><div><dt>Nondik konektatuko dira ikasleak?</dt><dd>Ikasgelako sare lokaletik (HTTP)</dd><dd><button type="button" aria-label="Aldatu: Nondik konektatuko dira ikasleak?">Aldatu</button></dd></div><div><dt>Aukerako funtzioak</dt><dd>Bat ere ez oraingoz</dd><dd><button type="button" aria-label="Aldatu: Aukerako funtzioak">Aldatu</button></dd></div></dl><p>Klasea tutoretza moduan gordeko da, erabilera-mugarik gabe eta proiektuko aldaketetarako ikaslearen onespena eskatuta.</p><div class="setup-actions"><button type="button">Atzera</button><button type="submit">Ireki nire klasea</button></div></fieldset></form></main>"`;

exports[`renders complete localized forms and keeps browser validation attributes > optional identity and HTTPS 1`] = `"<main class="shell setup-shell"><header class="masthead"><p class="eyebrow">Marea Code</p><h1>Eman ikasleei sarbidea</h1><label>Hizkuntza<select><option value="es">Español</option><option value="en">English</option><option value="eu" selected="">Euskara</option></select></label></header><ol class="setup-steps"><li>Zure klasea</li><li>Konektatu modelo bat</li><li aria-current="step">Eman ikasleei sarbidea</li><li>Aukerako funtzioak</li><li>Berrikusi eta hasi</li></ol><form aria-busy="false" noValidate=""><fieldset><legend class="sr-only">Eman ikasleei sarbidea</legend><fieldset><legend>Nondik konektatuko dira ikasleak?</legend><label class="setup-choice"><input type="radio" name="access" value="lan"/>Ikasgelako sare lokaletik (HTTP)</label><label class="setup-choice"><input type="radio" name="access" value="local"/>Ordenagailu honetatik soilik</label><label class="setup-choice"><input type="radio" name="access" checked="" value="https"/>HTTPS helbide batetik</label><p class="server-help">HTTP konfiantzazko sare lokal batean erabil daiteke. HTTPS erabiltzeko proxy bat konfiguratutako helbidea behar da.</p></fieldset><details class="connection-options"><summary>Konexio-aukerak</summary><label>Zerbitzariaren ataka<input required="" type="number" min="1024" max="65535" value="18793"/></label></details><label>HTTPS helbide publikoa<input required="" type="url" pattern="https://.*" placeholder="https://marea.example.edu" value=""/></label><fieldset><legend>Kanpoko kontuekin sarbidea (aukerakoa)</legend><p>Konfiguratu aplikazioa identitate-hornitzailean. Ondoren, eman ikasleei sarbidea klasearen ezarpenetan.</p><section class="identity-connection"><label class="setup-choice"><input type="checkbox" checked=""/>School identity</label><div class="setup-grid"><label>domain<input required="" autoComplete="off" maxLength="16384" type="text" value=""/></label><label>clientId<input required="" autoComplete="off" maxLength="16384" type="text" value=""/></label><label>clientSecret<span class="secret-control"><input required="" autoComplete="off" maxLength="16384" type="password" aria-label="clientSecret" value=""/><button type="button" aria-label="Erakutsi edo ezkutatu: clientSecret" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span></label></div></section></fieldset><div class="setup-actions"><button type="button">Atzera</button><button type="submit">Jarraitu</button></div></fieldset></form></main>"`;

