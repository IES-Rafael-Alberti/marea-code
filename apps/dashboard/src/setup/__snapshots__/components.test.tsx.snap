// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`offers local addresses without showing an editable port until connection options are opened > available LAN interfaces 1`] = `"<fieldset><legend>Where will students connect from?</legend><label class="setup-choice"><input type="radio" name="access" checked="" value="lan"/>The classroom local network (HTTP)</label><label class="setup-choice"><input type="radio" name="access" value="local"/>Only this computer</label><label class="setup-choice"><input type="radio" name="access" value="https"/>An HTTPS address</label><div class="setup-address"><div><p>Student connection address</p><p><code>http://192.168.1.20:18793</code></p><p><code>http://10.0.0.2:18793</code></p></div></div><p class="server-help">HTTP works on a trusted local network. HTTPS requires an address with a configured proxy.</p></fieldset><details class="connection-options"><summary>Connection options</summary><label>Server port<input required="" type="number" min="1024" max="65535" value="18793"/></label></details>"`;

exports[`optional features preserve each other's settings and the testing skill is independent > enabled optional features 1`] = `"<div class="setup-features"><section class="feature-choice"><label class="setup-choice"><input type="checkbox" checked=""/>Attention map</label><p>Helps identify students who may need your attention during class.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox" checked=""/>Class reports</label><p>Summarizes session evidence and difficulties for your review.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox" checked=""/>Automatic evaluation</label><p>When a session closes, prepares a draft for you to review before sharing.</p></section><section class="feature-choice"><label class="setup-choice"><input type="checkbox" checked=""/>Example skill: learning to write tests</label><p>Includes example goals and criteria for learning to test code. You can inspect and adapt it later.</p></section><p class="server-help">The map, reports and evaluation make additional requests to the chosen model. You can change their models and set limits in Settings → Server.</p></div>"`;

exports[`selects a provider once, starts an unlimited route and requires its actual model check > multiple providers awaiting selection 1`] = `"<div class="server-settings"><p>Enter your key and find the model students will use.</p><label>Connect a model<select><option value="" disabled="" selected="">Connect a model</option><option value="one">One</option><option value="missing" disabled="">missing</option></select></label><p>No providers installed.</p></div>"`;
