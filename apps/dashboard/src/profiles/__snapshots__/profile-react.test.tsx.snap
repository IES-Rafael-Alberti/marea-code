// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`adapts session rendering through the module lifecycle and cleans up even during load > failed-session-plugin 1`] = `"<section class="profile-module profile-slot-main profile-size-wide"><p role="alert">Module unavailable. Retry loading.<button>Retry</button></p><div></div></section>"`;

exports[`applies release themes and retains shell controls for empty and unavailable profiles > empty-profile-shell 1`] = `"<section class="profile-shell"><div class="workspace-toolbar"><label class="workspace-class"><span>Select a class</span><select><option value="" disabled="" selected="">Select a class to get started</option><option value="class:a">Class A</option><option value="class:b">Class B</option></select></label><nav class="workspace-navigation" aria-label="Main navigation"><button type="button" aria-current="page">Sessions</button><button type="button">Map</button><button type="button">Progress</button><button type="button">Reports</button><button type="button">Settings</button></nav></div><div hidden="" class="workspace-settings"><nav class="settings-navigation" aria-label="Settings sections"><button type="button">This class</button><button type="button">Server</button><button type="button" aria-current="page">My dashboard</button></nav><div class="settings-pages"><div hidden="" class="settings-page"><p class="settings-intro">How the tutor teaches, which skills students receive and which educational tools are active in the selected class.</p></div><div hidden="" class="settings-page"><p class="settings-intro">Providers, models and limits shared by every class on this server.</p><details class="workspace-advanced"><summary>Diagnostics and usage</summary><section aria-label="Telemetry preview fixture"></section><div class="settings-modules"></div></details></div><div class="settings-page"><p class="settings-intro">Your dashboard language, appearance and views.</p><details class="workspace-advanced" open=""><summary>Appearance and views</summary><label>Edit profile<select><option value="teacher" selected="">Personal defaults</option><option value="class" disabled="">My class view</option></select></label><details class="profile-editor"><summary>Dashboard appearance</summary><p role="status">Unsaved profile draft</p><fieldset><label>Theme<select><option value="org.marea.theme.high-contrast">High contrast</option><option value="org.marea.theme.marea" selected="">Marea</option></select></label><fieldset><ol></ol><button type="button">Visible: Sessions and evaluation</button></fieldset><label><input type="checkbox"/>Saving discards unavailable plugin settings</label><button type="button">Save</button><button type="button">Reset this scope</button></fieldset><button type="button">Read current state</button></details></details></div></div></div><div class="workspace-empty"><p>This view is not enabled in your dashboard.</p><button type="button">Enable in My dashboard</button></div><div class="workspace-content"><div class="workspace-view"></div><div hidden="" class="workspace-view"></div><div hidden="" class="workspace-view"></div><div hidden="" class="workspace-view"></div></div></section>"`;

exports[`registers the session draft guard, renders aside ordering and cancels before initial read completion > aside-profile-shell 1`] = `"<section class="profile-shell"><div class="workspace-toolbar"><label class="workspace-class"><span>Select a class</span><select><option value="" disabled="" selected="">Select a class to get started</option><option value="class:a">Class A</option><option value="class:b">Class B</option></select></label><nav class="workspace-navigation" aria-label="Main navigation"><button type="button" aria-current="page">Sessions</button><button type="button">Map</button><button type="button">Progress</button><button type="button">Reports</button><button type="button">Settings</button></nav></div><div hidden="" class="workspace-settings"><nav class="settings-navigation" aria-label="Settings sections"><button type="button">This class</button><button type="button">Server</button><button type="button" aria-current="page">My dashboard</button></nav><div class="settings-pages"><div hidden="" class="settings-page"><p class="settings-intro">How the tutor teaches, which skills students receive and which educational tools are active in the selected class.</p></div><div hidden="" class="settings-page"><p class="settings-intro">Providers, models and limits shared by every class on this server.</p><details class="workspace-advanced"><summary>Diagnostics and usage</summary><section aria-label="Telemetry preview fixture"></section><div class="settings-modules"></div></details></div><div class="settings-page"><p class="settings-intro">Your dashboard language, appearance and views.</p><details class="workspace-advanced" open=""><summary>Appearance and views</summary><label>Edit profile<select><option value="teacher" selected="">Personal defaults</option><option value="class" disabled="">My class view</option></select></label><details class="profile-editor"><summary>Dashboard appearance</summary><p role="status">Unsaved profile draft</p><fieldset><label>Theme<select><option value="org.marea.theme.high-contrast">High contrast</option><option value="org.marea.theme.marea" selected="">Marea</option></select></label><fieldset><ol><li><fieldset><legend>Sessions and evaluation</legend><label><input type="checkbox" checked=""/>Visible</label><button type="button" disabled="">Move up</button><button type="button" disabled="">Move down</button><details class="view-layout-options"><summary>Position · Size</summary><label>Position<select><option value="main">Main</option><option value="aside" selected="">Aside</option></select></label><label>Size<select><option value="compact" selected="">Compact</option><option value="standard">Standard</option><option value="wide">Wide</option></select></label></details></fieldset></li></ol></fieldset><label><input type="checkbox"/>Saving discards unavailable plugin settings</label><button type="button">Save</button><button type="button">Reset this scope</button></fieldset><button type="button">Read current state</button></details></details></div></div></div><div class="workspace-content"><div class="workspace-view"><section class="profile-module profile-slot-aside profile-size-compact"><div></div></section></div><div hidden="" class="workspace-view"></div><div hidden="" class="workspace-view"></div><div hidden="" class="workspace-view"></div></div></section>"`;
