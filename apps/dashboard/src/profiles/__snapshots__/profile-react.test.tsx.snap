// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`adapts session rendering through the module lifecycle and cleans up even during load > failed-session-plugin 1`] = `"<section class="profile-module profile-slot-main profile-size-wide"><p role="alert">Module unavailable. Retry loading.<button>Retry</button></p><div></div></section>"`;

exports[`applies release themes and retains shell controls for empty and unavailable profiles > empty-profile-shell 1`] = `"<section class="profile-shell"><label>Select a class<select><option value="" selected="">Select a class</option><option value="class:a">Class A</option></select></label><section aria-label="Telemetry preview fixture"></section><label>Edit profile<select><option value="teacher" selected="">Personal defaults</option><option value="class" disabled="">My class view</option></select></label><details class="profile-editor"><summary>Dashboard appearance</summary><p role="status">Unsaved profile draft</p><fieldset><label>Theme<select><option value="org.marea.theme.high-contrast">High contrast</option><option value="org.marea.theme.marea" selected="">Marea</option></select></label><fieldset><ol></ol><button type="button">Visible: Sessions and evaluation</button></fieldset><label><input type="checkbox"/>Saving discards unavailable plugin settings</label><button type="button">Save</button><button type="button">Reset this scope</button></fieldset><button type="button">Read current state</button></details><p>No visible modules. Use dashboard appearance to enable them.</p><div class="profile-layout"></div></section>"`;

exports[`registers the session draft guard, renders aside ordering and cancels before initial read completion > aside-profile-shell 1`] = `"<section class="profile-shell"><label>Select a class<select><option value="" selected="">Select a class</option><option value="class:a">Class A</option></select></label><section aria-label="Telemetry preview fixture"></section><label>Edit profile<select><option value="teacher" selected="">Personal defaults</option><option value="class" disabled="">My class view</option></select></label><details class="profile-editor"><summary>Dashboard appearance</summary><p role="status">Unsaved profile draft</p><fieldset><label>Theme<select><option value="org.marea.theme.high-contrast">High contrast</option><option value="org.marea.theme.marea" selected="">Marea</option></select></label><fieldset><ol><li><fieldset><legend>Sessions and evaluation</legend><label><input type="checkbox" checked=""/>Visible</label><button type="button" disabled="">Move up</button><button type="button" disabled="">Move down</button><label>Position<select><option value="main">Main</option><option value="aside" selected="">Aside</option></select></label><label>Size<select><option value="compact" selected="">Compact</option><option value="standard">Standard</option><option value="wide">Wide</option></select></label></fieldset></li></ol></fieldset><label><input type="checkbox"/>Saving discards unavailable plugin settings</label><button type="button">Save</button><button type="button">Reset this scope</button></fieldset><button type="button">Read current state</button></details><div class="profile-layout"><section class="profile-module profile-slot-aside profile-size-compact"><p role="alert">Module unavailable. Retry loading.<button>Retry</button></p><div></div></section></div></section>"`;
