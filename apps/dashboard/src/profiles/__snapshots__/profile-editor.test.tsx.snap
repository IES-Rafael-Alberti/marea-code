exports[`localizes every profile state and inheritance control in es > class-editor-es-catalog 1`] = `"<details class="profile-editor"><summary>Aspecto del panel</summary><p role="status">Borrador de perfil sin guardar</p><p role="alert">Esta página usa otra versión de complementos. Se conserva tu borrador. Recarga después de anotar el borrador.</p><p role="status">Algunas preferencias guardadas no están disponibles. Sustituir este ámbito descarta esos ajustes.</p><fieldset><label><input type="checkbox" checked=""/>Heredar tema personal</label><label><input type="checkbox" checked=""/>Heredar módulos personales</label><label>Tema<select disabled=""><option value="org.marea.theme.high-contrast">Alto contraste</option><option value="org.marea.theme.marea" selected="">Marea</option></select></label><fieldset disabled=""><ol><li><fieldset><legend>Sesiones y evaluación</legend><label><input type="checkbox" checked=""/>Visible</label><button type="button" disabled="">Subir</button><button type="button" disabled="">Bajar</button><label>Posición<select><option value="main" selected="">Principal</option><option value="aside">Lateral</option></select></label><label>Tamaño<select><option value="compact">Compacto</option><option value="standard">Estándar</option><option value="wide" selected="">Amplio</option></select></label></fieldset></li></ol></fieldset><label><input type="checkbox"/>Guardar descarta los ajustes de complementos no disponibles</label><button type="button" disabled="">Guardar</button><button type="button" disabled="">Restablecer este ámbito</button></fieldset><button type="button">Leer estado actual</button><div><p>El valor guardado actual coincide con tu borrador.</p><button>Aceptar estado actual</button><button>Conservar borrador sobre la revisión actual</button></div></details>"`;

