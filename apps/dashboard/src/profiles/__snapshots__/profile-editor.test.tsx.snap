exports[`localizes every profile state and inheritance control in es > class-editor-es-uncertain 1`] = `"<details class="profile-editor"><summary>Aspecto del panel</summary><p role="status">Borrador de perfil sin guardar</p><p role="alert">No se pudo confirmar el guardado. La consulta no repite la escritura. Revisa antes de continuar.</p><p role="status">Algunas preferencias guardadas no están disponibles. Sustituir este ámbito descarta esos ajustes.</p><fieldset><label><input type="checkbox" checked=""/>Heredar tema personal</label><label><input type="checkbox" checked=""/>Heredar módulos personales</label><label>Tema<select disabled=""><option value="org.marea.theme.high-contrast">Alto contraste</option><option value="org.marea.theme.marea" selected="">Marea</option></select></label><fieldset disabled=""><ol><li><fieldset><legend>Sesiones y evaluación</legend><label><input type="checkbox" checked=""/>Visible</label><button type="button" disabled="">Subir</button><button type="button" disabled="">Bajar</button><label>Posición<select><option value="main" selected="">Principal</option><option value="aside">Lateral</option></select></label><label>Tamaño<select><option value="compact">Compacto</option><option value="standard">Estándar</option><option value="wide" selected="">Amplio</option></select></label></fieldset></li></ol></fieldset><label><input type="checkbox"/>Guardar descarta los ajustes de complementos no disponibles</label><button type="button" disabled="">Guardar</button><button type="button" disabled="">Restablecer este ámbito</button></fieldset><button type="button">Leer estado actual</button><div><p>El valor guardado actual coincide con tu borrador.</p><button>Aceptar estado actual</button><button>Conservar borrador sobre la revisión actual</button></div></details>"`;

exports[`localizes every profile state and inheritance control in eu > class-editor-eu-catalog 1`] = `"<details class="profile-editor"><summary>Panelaren itxura</summary><p role="status">Gorde gabeko profil-zirriborroa</p><p role="alert">Orri honek beste plugin-bertsio bat erabiltzen du. Zirriborroa mantendu da. Berriz kargatu zirriborroa apuntatu ondoren.</p><p role="status">Gordetako hobespen batzuk ez daude erabilgarri. Eremua ordezteak ezarpen horiek baztertzen ditu.</p><fieldset><label><input type="checkbox" checked=""/>Gai pertsonala heredatu</label><label><input type="checkbox" checked=""/>Modulu pertsonalak heredatu</label><label>Gaia<select disabled=""><option value="org.marea.theme.high-contrast">Kontraste handia</option><option value="org.marea.theme.marea" selected="">Marea</option></select></label><fieldset disabled=""><ol><li><fieldset><legend>Saioak eta ebaluazioa</legend><label><input type="checkbox" checked=""/>Ikusgai</label><button type="button" disabled="">Gora</button><button type="button" disabled="">Behera</button><label>Kokapena<select><option value="main" selected="">Nagusia</option><option value="aside">Albokoa</option></select></label><label>Tamaina<select><option value="compact">Trinkoa</option><option value="standard">Estandarra</option><option value="wide" selected="">Zabala</option></select></label></fieldset></li></ol></fieldset><label><input type="checkbox"/>Gordetzeak erabilgarri ez dauden pluginen ezarpenak baztertzen ditu</label><button type="button" disabled="">Gorde</button><button type="button" disabled="">Eremu hau berrezarri</button></fieldset><button type="button">Uneko egoera irakurri</button><div><p>Gordetako uneko balioa zirriborroarekin bat dator.</p><button>Uneko egoera onartu</button><button>Zirriborroa uneko berrikuspenarekin mantendu</button></div></details>"`;

