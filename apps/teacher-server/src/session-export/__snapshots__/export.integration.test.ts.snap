{"type":"event","runId":"run:a","event":{"eventId":"event:run:a:1","sequence":1,"occurredAt":"2026-09-07T12:00:00.000Z","eventType":"assistant-message","content":"Canonical 1"}}
{"type":"event","runId":"run:a","event":{"eventId":"event:run:a:2","sequence":2,"occurredAt":"2026-09-07T12:00:00.000Z","eventType":"assistant-message","content":"Canonical 2"}}",
  "sessions.csv": "session,class,student,project,opened_at,closed_at,duration_ms,events,model_attempts,unknown_attempts,known_input_tokens,known_output_tokens,known_cost_by_unit,turn_errors,model_diagnostics
"run:a","one","s1","Synthetic project","2026-09-07T12:00:00.000Z",,,"2","1","0","2","3","{""nano-USD"":4}","0","not captured"",
  "usage.jsonl": "{"runId":"run:a","requestId":"request","attempt":1,"purpose":"tutoring","state":"settled","inputTokens":2,"outputTokens":3,"costUnits":4,"costUnit":"nano-USD","startedAt":"2026-09-07T12:00:00.000Z","endedAt":"2026-09-07T12:00:00.000Z"}",
