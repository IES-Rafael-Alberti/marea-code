// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`removes only the Windows user PATH entry and fails before file deletion if that fails > remove only managed user PATH 1`] = `"[["powershell.exe",["-NoProfile","-Command","$p=[Environment]::GetEnvironmentVariable('Path','User'); $parts=@($p -split ';' | Where-Object { $_.TrimEnd('\\\\') -ine '/managed/bin'.TrimEnd('\\\\') }); [Environment]::SetEnvironmentVariable('Path',($parts -join ';'),'User')"],{"encoding":"utf8"}],["powershell.exe",["-NoProfile","-Command","$p=[Environment]::GetEnvironmentVariable('Path','User'); $parts=@($p -split ';' | Where-Object { $_.TrimEnd('\\\\') -ine '/managed/bin'.TrimEnd('\\\\') }); [Environment]::SetEnvironmentVariable('Path',($parts -join ';'),'User')"],{"encoding":"utf8"}]]"`;
